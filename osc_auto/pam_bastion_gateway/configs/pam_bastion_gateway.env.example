# =============================================================================
# pam_bastion_gateway — template environment (omnisight W3 / SESI 4.2).
#
# Linux : salin ke /etc/pam_bastion_gateway/pam_bastion_gateway.env — WAJIB
#         chmod 0600 root:root.
# Windows: set melalui registry Environment service (lihat
#          deploy/windows/install-service.ps1) atau System Environment
#          dengan ACL terbatas. JANGAN commit file asli.
# =============================================================================

# --- osc_rest ----------------------------------------------------------------
# Base URL osc_rest (redeem ticket, upload rekaman). Produksi: https.
RUST_API_BASE_URL=http://osc_rest:8000

# --- WebSocket gateway ---------------------------------------------------------
# Alamat bind server WS.
PAM_GATEWAY_LISTEN=:8090

# Path upgrade WebSocket (harus konsisten dengan BFF/UI).
PAM_GATEWAY_WS_PATH=/gateway/ws

# Origin yang diizinkan melakukan upgrade (CSV). KOSONG = SEMUA ORIGIN DITOLAK
# (deny-by-default — anti cross-site WebSocket hijacking). Contoh:
#   PAM_GATEWAY_ALLOWED_ORIGINS=https://omnisight.corp.local,https://noc.corp.local
#PAM_GATEWAY_ALLOWED_ORIGINS=

# Batas sesi bastion konkuren (1..1000).
PAM_GATEWAY_MAX_SESSIONS=20

# --- SSH target -----------------------------------------------------------------
# Path file known_hosts gateway (TOFU: host key target dicatat pada first use;
# koneksi ditolak bila host key berubah). Default: <dir state>/known_hosts.
#PAM_GATEWAY_KNOWN_HOSTS=

# --- Rekaman sesi (opsional) ------------------------------------------------------
# Direktori dump rekaman lokal untuk forensik; rekaman utama diunggah ke
# osc_rest → bucket privat RustFS (RUSTFS_BUCKET_PAM).
#PAM_GATEWAY_RECORDING_DIR=

# --- State kredensial (hasil --enroll) --------------------------------------------
# Lokasi state (default /var/lib/pam_bastion_gateway/state.json Linux,
# C:\ProgramData\pam_bastion_gateway\state.json Windows).
#PAM_GATEWAY_STATE_PATH=

# Key enkripsi AES-256-GCM state (64 hex char) — disarankan (state memuat
# hmac_secret yang bisa redeem kredensial target).
# Generate: openssl rand -hex 32
#PAM_GATEWAY_STATE_KEY_HEX=

# --- Logging -----------------------------------------------------------------------
# debug | info | warn | error (JSON terstruktur ke stdout; ticket & secret
# tidak pernah di-log).
PAM_GATEWAY_LOG_LEVEL=info
