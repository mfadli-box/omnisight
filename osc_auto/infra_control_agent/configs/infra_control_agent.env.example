# =============================================================================
# infra_control_agent — template environment (omnisight W2 / SESI 3.2).
#
# Linux : salin ke /etc/infra_control_agent/infra_control_agent.env — WAJIB
#         chmod 0600 root:root.
# Windows: set melalui registry Environment service (lihat
#          deploy/windows/install-service.ps1). JANGAN commit file asli.
# =============================================================================

# Base URL osc_rest. Di dalam docker compose: http://osc_rest:8000
RUST_API_BASE_URL=http://osc_rest:8000

# Interval poll outbox dispatch (rentang 5s..10m).
INFRA_CONTROL_POLL_INTERVAL=10s

# Root direktori compose stack (WAJIB absolut; validasi path ketat — semua
# working_dir dispatch harus berada di dalamnya).
#   Linux  : /opt/omnisight/stacks
#   Windows: C:\omnisight\stacks
#INFRA_CONTROL_STACKS_DIR=

# Direktori file konfigurasi vhost nginx (WAJIB absolut; harus termasuk
# dalam include utama /etc/nginx/nginx.conf).
#   Linux  : /etc/nginx/conf.d
#   Windows: C:\nginx\conf
#INFRA_CONTROL_NGINX_CONFIG_DIR=

# Binary eksekusi (di-resolve dari PATH; argumen selalu eksplisit — tanpa shell).
INFRA_CONTROL_DOCKER_BIN=docker
INFRA_CONTROL_NGINX_BIN=nginx

# Override path state kredensial (opsional).
#INFRA_CONTROL_STATE_PATH=

# Opsional: key AES-256-GCM 32 byte (64 hex) untuk enkripsi file state.
# Generate: openssl rand -hex 32
#INFRA_CONTROL_STATE_KEY_HEX=

# Tingkat log: debug | info | warn | error (log JSON ke stdout).
INFRA_CONTROL_LOG_LEVEL=info
