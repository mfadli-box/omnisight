# =============================================================================
# agent_cs — template environment (fase bootstrap).
#
# Linux : salin ke /etc/agent_cs/agent_cs.env — WAJIB chmod 0600 root:root.
# Windows: set melalui registry Environment service (lihat
#          deploy/windows/install-service.ps1) atau System Environment
#          dengan ACL terbatas. JANGAN commit file asli.
# =============================================================================

# Base URL osc_rest. Di dalam docker compose: http://osc_rest:8000
# (agent di host → gunakan endpoint yang terjangkau; produksi: https).
RUST_API_BASE_URL=http://osc_rest:8000

# Token API osc_rest (dipasang pada fase auth sebagai Bearer JWT).
# Kosong = tanpa header Authorization (health masih public sekarang).
RUST_API_TOKEN=

# Interval antar-probe (rentang valid 1s..1h).
AGENT_CS_INTERVAL=30s

# Tingkat log: debug | info | warn | error (log JSON ke stdout).
AGENT_CS_LOG_LEVEL=info
