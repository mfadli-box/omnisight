[Unit]
Description=OmniSight telemetry agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/omnisight/agent.env
ExecStart=/usr/local/bin/omnisight-agent
Restart=on-failure
RestartSec=5s
User=omnisight-agent
Group=omnisight-agent
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
