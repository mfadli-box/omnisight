# Salin menjadi `.env` sebelum menjalankan docker-compose.agent.yml
# Jangan commit berkas `.env` (berisi rahasia).

# Zona waktu container
TZ=Asia/Jakarta

# URL grup agent di osc_rest (harus diakhiri /rest/agent)
OSC_REST_URL=http://host.docker.internal:37772/rest/agent

# Token agent (samakan dengan CR_KEYS yang diharapkan osc_rest).
# WAJIB diisi di produksi.
OSC_AGENT_TOKEN=

# Interval heartbeat (detik)
OSC_AGENT_INTERVAL=30

# Identitas agen (opsional; ada default per service)
OSC_AGENT_ID=agent-vm-01
OSC_AGENT_ID_CI=agent-ci-01
OSC_AGENT_ID_MX=agent-mx-01
OSC_AGENT_ID_WS=agent-ws-01

# GID grup docker host, untuk agen POD non-root (opsional)
# DOCKER_GID=999
