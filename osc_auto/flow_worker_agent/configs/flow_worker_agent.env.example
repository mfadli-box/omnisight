# =============================================================================
# flow_worker_agent — template environment (omnisight W3 / SESI 4.2).
#
# Linux : salin ke /etc/flow_worker_agent/flow_worker_agent.env — WAJIB
#         chmod 0600 root:root.
# Windows: set melalui registry Environment service (lihat
#          deploy/windows/install-service.ps1) atau System Environment
#          dengan ACL terbatas. JANGAN commit file asli.
# =============================================================================

# --- osc_rest ----------------------------------------------------------------
# Base URL osc_rest (dipakai enrollment + purge retensi). Produksi: https.
RUST_API_BASE_URL=http://osc_rest:8000

# --- Listener enqueue (inbound dari produsen antrean outbox) -----------------
# Aktifkan listener HTTP penerima pesan notifikasi? (true/false)
FLOW_WORKER_LISTEN_ENABLED=true

# Alamat bind listener. Di dalam docker network internal: :8095.
# FLOW_WORKER_LISTEN=:8095

# Shared secret HMAC listener — WAJIB saat listener aktif (deny-by-default:
# tanpa secret valid agent menolak start). 64 karakter hex (32 byte).
# Produsen menandatangani kanonis "{ts}\n{METHOD}\n{path}\n{sha256_hex(body)}"
# dengan header X-Flow-Timestamp (±30 s) + X-Flow-Signature.
# Generate: openssl rand -hex 32
#FLOW_WORKER_LISTEN_SECRET_HEX=

# --- Dispatcher (worker pool pengirim) ---------------------------------------
# Jumlah goroutine pengirim paralel (1..64).
FLOW_WORKER_WORKERS=4

# Percobaan maksimum per pesan sebelum dead-letter (1..20). Backoff
# exponential + full jitter: 30s × 2^attempt, plafon 15 menit.
FLOW_WORKER_MAX_ATTEMPTS=5

# Interval loop claim antrean.
FLOW_WORKER_DISPATCH_INTERVAL=1s

# --- Antrean durable lokal ---------------------------------------------------
# Lokasi file antrean (default: <dir state>/queue.json, 0600).
#FLOW_WORKER_QUEUE_PATH=

# Key enkripsi AES-256-GCM antrean — DISARANKAN karena payload memuat
# konfigurasi channel ber-secret (SMTP password, bot token). 64 hex char.
# Generate: openssl rand -hex 32
#FLOW_WORKER_QUEUE_KEY_HEX=

# --- Data Retention Cleanup --------------------------------------------------
# Jalankan job purge retensi terjadwal? (true/false)
FLOW_WORKER_RETENTION_ENABLED=true

# Interval eksekusi purge (clamp 1h..7d; default 24h — job harian).
FLOW_WORKER_RETENTION_INTERVAL=24h

# Dry-run (server menghitung tanpa menghapus)? (true/false)
FLOW_WORKER_RETENTION_DRY_RUN=false

# --- State kredensial (hasil --enroll) ---------------------------------------
# Lokasi state (default /var/lib/flow_worker_agent/state.json Linux,
# C:\ProgramData\flow_worker_agent\state.json Windows).
#FLOW_WORKER_STATE_PATH=

# Key enkripsi AES-256-GCM state (64 hex char) — opsional tapi disarankan.
#FLOW_WORKER_STATE_KEY_HEX=

# --- Logging -----------------------------------------------------------------
# debug | info | warn | error (JSON terstruktur ke stdout).
FLOW_WORKER_LOG_LEVEL=info
