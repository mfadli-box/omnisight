# =============================================================================
# flow_worker_agent — systemd unit (omnisight W3 / SESI 4.2)
#
# Pemasangan:
#   sudo install -m 0755 bin/flow_worker_agent /usr/local/bin/
#   sudo install -m 0644 deploy/linux/flow_worker_agent.service /etc/systemd/system/
#   sudo mkdir -p /etc/flow_worker_agent && sudo install -m 0600 \
#        configs/flow_worker_agent.env.example /etc/flow_worker_agent/flow_worker_agent.env
#   # enroll sekali (token dari admin osc_rest):
#   sudo -u omnisight /usr/local/bin/flow_worker_agent --enroll <TOKEN> \
#        --asset-model <UUID> --status-label <UUID>
#   sudo systemctl daemon-reload && sudo systemctl enable --now flow_worker_agent
# =============================================================================

[Unit]
Description=omnisight flow_worker_agent - notification dispatcher & retention cleanup
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# User dinamis non-root (UID unik per-service, dibuat systemd).
DynamicUser=yes
# State kredensial (hmac_secret) + antrean durable membutuhkan StateDirectory.
StateDirectory=flow_worker_agent
StateDirectoryMode=0700
EnvironmentFile=-/etc/flow_worker_agent/flow_worker_agent.env
ExecStart=/usr/local/bin/flow_worker_agent
Restart=on-failure
RestartSec=5s

# --- Hardening (least privilege) ---------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Hanya jaringan — listener enqueue + SMTP/Telegram/webhook + osc_rest.
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

# --- Logging -------------------------------------------------------------------
# Agent menulis log JSON terstruktur ke stdout; journald yang mengumpulkan.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flow_worker_agent

[Install]
WantedBy=multi-user.target
