# =============================================================================
# host_telemetry_agent — template environment (omnisight W2 / SESI 3.2).
#
# Linux : salin ke /etc/host_telemetry_agent/host_telemetry_agent.env — WAJIB
#         chmod 0600 root:root.
# Windows: set melalui registry Environment service (lihat
#          deploy/windows/install-service.ps1) atau System Environment dengan
#          ACL terbatas. JANGAN commit file asli.
# =============================================================================

# Base URL osc_rest. Di dalam docker compose: http://osc_rest:8000
# (agent di host → gunakan endpoint yang terjangkau; produksi: https).
RUST_API_BASE_URL=http://osc_rest:8000

# Interval siklus pengumpulan metrik (rentang valid 1s..1h).
HOST_TELEMETRY_INTERVAL=60s

# Interval pengiriman ulang inventaris hardware/software (rentang 1m..24h).
HOST_TELEMETRY_INVENTORY_INTERVAL=1h

# Kumpulkan stats Docker container via Engine API? (true/false)
HOST_TELEMETRY_DOCKER_ENABLED=true

# --- File Integrity Monitoring (FIM) — W3 (SESI 4.2) ------------------------
# Aktifkan FIM ringan (SCHEDULED checksum SHA-256 + permission scan)?
HOST_TELEMETRY_FIM_ENABLED=true

# Interval scan FIM (rentang valid 1m..24h; scan pertama membangun baseline).
HOST_TELEMETRY_FIM_INTERVAL=15m

# Daftar path kritikal yang dipantau (CSV, absolut). Kosong = default:
#   Linux  : /etc,/usr/local/bin,/usr/local/sbin
#   Windows: C:\Windows\System32\drivers\etc,C:\Windows\System32\config
# Contoh: HOST_TELEMETRY_FIM_PATHS=/etc,/usr/bin,/opt/app/config
#HOST_TELEMETRY_FIM_PATHS=

# Socket/pipe Engine API (opsional; default /var/run/docker.sock Linux,
# \\.\pipe\docker_engine Windows).
#HOST_TELEMETRY_DOCKER_SOCKET=

# UUID docker_hosts milik company agent (WAJIB untuk metrics container —
# dilihat dari UI Docker Hosts di osc_site, atau GET /api/v1/docker/hosts).
HOST_TELEMETRY_DOCKER_HOST_ID=

# Override path state kredensial (opsional; default
# /var/lib/host_telemetry_agent/state.json atau C:\ProgramData\...).
#HOST_TELEMETRY_STATE_PATH=

# Opsional: key AES-256-GCM 32 byte (64 hex) untuk enkripsi file state.
# Generate: openssl rand -hex 32
#HOST_TELEMETRY_STATE_KEY_HEX=

# Tingkat log: debug | info | warn | error (log JSON ke stdout).
HOST_TELEMETRY_LOG_LEVEL=info
