# =============================================================================
# network_poller_agent — template environment (omnisight W2 / SESI 3.2).
#
# Linux : salin ke /etc/network_poller_agent/network_poller_agent.env — WAJIB
#         chmod 0600 root:root.
# Windows: set melalui registry Environment service (lihat
#          deploy/windows/install-service.ps1). JANGAN commit file asli.
# =============================================================================

# Base URL osc_rest. Di dalam docker compose: http://osc_rest:8000
RUST_API_BASE_URL=http://osc_rest:8000

# Interval siklus polling (rentang valid 10s..1h; sebaiknya kelipatan
# interval terkecil monitor).
NETWORK_POLLER_INTERVAL=60s

# Timeout default per probe HTTP/TCP/DNS (rentang 1s..1m).
NETWORK_POLLER_PROBE_TIMEOUT=10s

# Timeout per request SNMP UDP (rentang 500ms..30s).
NETWORK_POLLER_SNMP_TIMEOUT=3s

# Path file daftar monitor/SNMP (hot-reload tiap siklus). Default:
#   Linux  : /etc/network_poller_agent/monitors.json
#   Windows: C:\ProgramData\network_poller_agent\monitors.json
# File harus chmod 0600 (memuat SNMP community plaintext).
#NETWORK_POLLER_MONITORS_FILE=

# Override path state kredensial (opsional).
#NETWORK_POLLER_STATE_PATH=

# Opsional: key AES-256-GCM 32 byte (64 hex) untuk enkripsi file state.
# Generate: openssl rand -hex 32
#NETWORK_POLLER_STATE_KEY_HEX=

# Tingkat log: debug | info | warn | error (log JSON ke stdout).
NETWORK_POLLER_LOG_LEVEL=info
