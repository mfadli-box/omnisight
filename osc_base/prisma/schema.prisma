// =============================================================================
// omnisight — Core Schema Part 1 (Multi-Company, HRIS Cache, MFA, RBAC,
//              Menu Privilege, Studio Metadata, Notification, Agent Enrollment)
//              + Part 2 (ITAM & Service Desk: Snipe-IT/GLPI; DCIM & IPAM: NetBox/LibreNMS)
//              + Part 3 (Telemetry & Retention, Uptime/Status Page, Nginx Control
//                Plane, Docker/Compose, Alerting, SecOps SIEM/FIM/CVE/SCA, PAM
//                Bastion & Vault, File Asset Registry)
// Author    : ai-base (Database Engineer)
// Blueprint : osc_docs/reengineering.md (bab 3, 5.1–5.8)
// Doc       : osc_docs/base/schema-p1.md + osc_docs/base/schema-p2.md + osc_docs/base/schema-p3.md
//
// Konvensi (mengikuti schema-core.md bootstrap):
//   - Model PascalCase, field camelCase -> snake_case di PostgreSQL via
//     @map("column_name") dan @@map("table_name")
//   - Tipe native PostgreSQL eksplisit (@db.Uuid, @db.Timestamptz(3), ...)
//   - Referential actions eksplisit (onDelete/onUpdate) di setiap relasi
//   - Audit fields (createdAt/updatedAt) + soft-delete (deletedAt)
//   - UUID PK memakai gen_random_uuid() (native sejak PostgreSQL 13)
//   - Secret (TOTP, webhook/bot token, config channel) TIDAK pernah plaintext:
//     dienkripsi Envelope AES-256-GCM di level osc_rest (Bytes = bytea)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL dibaca dari osc_base/.env untuk Prisma CLI (migrasi/format/
  // validate); container runtime (osc_rest) memakai DATABASE_URL internal.
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enum
// -----------------------------------------------------------------------------

/// Aksi CRUD Directus-style untuk Permission
enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE

  @@map("permission_action")
}

/// Tipe channel notifikasi (reengineering.md bab 5.8)
enum NotificationChannelType {
  SMTP_EMAIL
  TELEGRAM
  WEBHOOK

  @@map("notification_channel_type")
}

/// Tipe node target enrollment agent (reengineering.md bab 3 — dipakai P2/P3)
enum NodeType {
  HOST
  NETWORK
  VIRTUAL
  CONTAINER
  RACK_MOUNTED
  SERVICE

  @@map("node_type")
}

// -----------------------------------------------------------------------------
// Multi-Company tenant master (bab 5.1)
// -----------------------------------------------------------------------------

/// Master tenant. hris_login_url NULL/kosong = Local Login mode;
/// terisi = HRIS ASMX template URL ({\(U} username, {\)P} password).
model Company {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String    @db.VarChar(150)
  code              String    @unique @db.VarChar(50)
  hrisLoginUrl      String?   @map("hris_login_url") @db.VarChar(500)
  hrisCacheTtlHours Int       @default(72) @map("hris_cache_ttl_hours")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  accesses              UserCompanyAccess[]
  menuPrivileges        CompanyMenuPrivilege[]
  sessions              Session[]
  notificationChannels  NotificationChannel[]
  webhookFlows          WebhookFlow[]
  agentEnrollmentTokens AgentEnrollmentToken[]
  activityLogs          ActivityLog[]

  // --- Part 2: ITAM & Service Desk ---
  departments                Department[]
  locations                  Location[]
  categories                 Category[]
  manufacturers              Manufacturer[]
  suppliers                  Supplier[]
  statusLabels               StatusLabel[]
  assetModels                AssetModel[]
  assets                     Asset[]
  assetCheckoutLogs          AssetCheckoutLog[]
  softwareLicenses           SoftwareLicense[]
  licenseSeats               LicenseSeat[]
  hardwareInventorySnapshots HardwareInventorySnapshot[]
  tickets                    Ticket[]
  ticketFollowups            TicketFollowup[]

  // --- Part 2: DCIM & IPAM ---
  sites                    Site[]
  racks                    Rack[]
  rackUnitAllocations      RackUnitAllocation[]
  deviceInterfaces         DeviceInterface[]
  cableConnections         CableConnection[]
  vlans                    Vlan[]
  ipPrefixes               IpPrefix[]
  ipAddresses              IpAddress[]
  snmpDeviceProfiles       SnmpDeviceProfile[]
  interfaceMetricSnapshots InterfaceMetricSnapshot[]

  // --- Part 3: Telemetry, Uptime, Nginx, Docker, Alerting, SecOps, PAM ---
  uptimeMonitors           UptimeMonitor[]
  uptimeHeartbeats         UptimeHeartbeat[]
  statusPages              StatusPage[]
  nginxNodes               NginxNode[]
  nginxVirtualHosts        NginxVirtualHost[]
  dockerHosts              DockerHost[]
  composeStacks            ComposeStack[]
  systemMetricSnapshots    SystemMetricSnapshot[]
  containerMetricSnapshots ContainerMetricSnapshot[]
  alertRules               AlertRule[]
  alertHistories           AlertHistory[]
  fimBaselineEvents        FimBaselineEvent[]
  securityAlertEvents      SecurityAlertEvent[]
  vulnerabilityFindings    VulnerabilityFinding[]
  complianceCheckResults   ComplianceCheckResult[]
  pamVaultAccounts         PamVaultAccount[]
  pamAccessPolicies        PamAccessPolicy[]
  pamSessionLogs           PamSessionLog[]
  fileAssets               FileAsset[]
  statusPageMonitors       StatusPageMonitor[]

  @@index([isActive])
  @@map("companies")
}

// -----------------------------------------------------------------------------
// Identity, HRIS sync & MFA (bab 5.1–5.3)
// -----------------------------------------------------------------------------

/// Pengguna aplikasi. password_hash = Argon2id cache dari HRIS login
/// (atau hash lokal untuk Local Login mode); tidak pernah menyimpan plaintext.
model User {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username            String    @unique @db.VarChar(100)
  email               String    @unique @db.VarChar(255)
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  displayName         String?   @map("display_name") @db.VarChar(100)
  lastHrisSyncAt      DateTime? @map("last_hris_sync_at") @db.Timestamptz(3)
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  /// TOTP secret terenkripsi Envelope AES-256-GCM (KEK terpisah)
  mfaSecretEncrypted  Bytes?    @map("mfa_secret_encrypted")
  /// Anti-replay: step TOTP terakhir yang lolos; step sama/lebih lama ditolak
  mfaLastVerifiedStep BigInt?   @map("mfa_last_verified_step")
  /// Kode backup sekali pakai (hash Argon2id; tercairkan = dihapus dari array)
  mfaBackupCodesHash  String[]  @default([]) @map("mfa_backup_codes_hash") @db.VarChar(255)
  isSuperAdmin        Boolean   @default(false) @map("is_super_admin")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)

  sessions     Session[]
  accesses     UserCompanyAccess[]
  activityLogs ActivityLog[]

  // --- Part 2: ITAM & Service Desk (relasi balik) ---
  managedDepartments Department[]       @relation("DepartmentManager")
  assignedAssets     Asset[]            @relation("AssetAssignee")
  checkoutLogActions AssetCheckoutLog[] @relation("CheckoutLogActor")
  checkoutLogTargets AssetCheckoutLog[] @relation("CheckoutLogTarget")
  requestedTickets   Ticket[]           @relation("TicketRequester")
  assignedTickets    Ticket[]           @relation("TicketAssignee")
  ticketFollowups    TicketFollowup[]
  licenseSeats       LicenseSeat[]

  // --- Part 3: SecOps & PAM (relasi balik) ---
  acknowledgedSecurityAlerts SecurityAlertEvent[] @relation("SecurityAlertAcknowledger")
  resolvedFimEvents          FimBaselineEvent[]   @relation("FimEventResolver")
  pamSessionLogs             PamSessionLog[]

  /// Offline cache fallback: now() - last_hris_sync_at <= ttl (bab 5.2)
  @@index([lastHrisSyncAt])
  @@index([isActive])
  @@map("users")
}

/// Sesi login revocable DB-backed (pola Nginx UI AuthToken; bab 5.4).
/// Token acuan disimpan sebagai hash, bukan plaintext.
model Session {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  activeCompanyId String?   @map("active_company_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.VarChar(255)
  ipAddress       String?   @map("ip_address") @db.Inet
  userAgent       String?   @map("user_agent") @db.VarChar(500)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  company Company? @relation(fields: [activeCompanyId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([activeCompanyId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// -----------------------------------------------------------------------------
// RBAC: Role -> Policy -> Permission (pola Directus; bab 4 "Policy RBAC")
// -----------------------------------------------------------------------------

/// Peran pengguna dalam konteks Company (via UserCompanyAccess)
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  accesses       UserCompanyAccess[]
  menuPrivileges CompanyMenuPrivilege[]
  policies       RolePolicy[]

  @@map("roles")
}

/// Policy = kumpulan permission yang dapat dipakai lintas role (Directus-style)
model Policy {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles       RolePolicy[]
  permissions Permission[]

  @@map("policies")
}

/// Join m2m Role <-> Policy
model RolePolicy {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId   String @map("role_id") @db.Uuid
  policyId String @map("policy_id") @db.Uuid

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roleId, policyId])
  @@index([policyId])
  @@map("role_policies")
}

/// Permission CRUD per koleksi: union multi-policy (OR) dievaluasi di
/// osc_rest; fieldsAllowed = field-level allowed columns; rowFilter = aturan
/// filter baris JSON (AST -> SQL parameterized, identifier tervalidasi).
model Permission {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId      String           @map("policy_id") @db.Uuid
  collection    String           @db.VarChar(100)
  action        PermissionAction
  /// Kolom yang diizinkan; [] / NULL = semua field
  fieldsAllowed String[]         @default([]) @map("fields_allowed") @db.VarChar(100)
  /// JSON row filter rules (Filter AST parameterized) — NULL = semua baris
  rowFilter     Json?            @map("row_filter") @db.JsonB
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([policyId, collection, action])
  @@index([collection, action])
  @@map("permissions")
}

// -----------------------------------------------------------------------------
// Company Switcher (bab 5.4)
// -----------------------------------------------------------------------------

/// Akses user ke Company dengan role berbeda per Company.
/// User boleh punya >1 role pada company yang sama (UNIQUE 3 kolom);
/// tepat satu baris is_default=true per user di-enforce level aplikasi.
model UserCompanyAccess {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  isDefault Boolean  @default(false) @map("is_default")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, companyId, roleId])
  @@index([companyId])
  @@index([roleId])
  @@map("user_company_access")
}

// -----------------------------------------------------------------------------
// Menu Privilege / sidebar dinamis (bab 5.5)
// -----------------------------------------------------------------------------

/// Registry master modul/menu (tree via parent_id), diisi seeder idempotent
/// dari manifest deklaratif kode
model MenuModule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(100)
  label     String   @db.VarChar(150)
  routePath String?  @map("route_path") @db.VarChar(300)
  icon      String?  @db.VarChar(100)
  parentId  String?  @map("parent_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent     MenuModule?            @relation("MenuModuleTree", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children   MenuModule[]           @relation("MenuModuleTree")
  privileges CompanyMenuPrivilege[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("menu_modules")
}

/// Privilege menu per Company + Role: item can_view=false tidak dikirim ke UI
model CompanyMenuPrivilege {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  menuId    String   @map("menu_id") @db.Uuid
  canView   Boolean  @default(false) @map("can_view")
  canCreate Boolean  @default(false) @map("can_create")
  canUpdate Boolean  @default(false) @map("can_update")
  canDelete Boolean  @default(false) @map("can_delete")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role    Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  menu    MenuModule @relation(fields: [menuId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([companyId, roleId, menuId])
  @@index([roleId])
  @@index([menuId])
  @@map("company_menu_privileges")
}

// -----------------------------------------------------------------------------
// Studio: metadata koleksi dinamis (3 tabel Directus-style; DDL runtime di
// osc_rest via dynamic SQL — BUKAN via Prisma migrate)
// -----------------------------------------------------------------------------

/// Metadata koleksi dinamis (tabel 1/3 Directus collections)
model CollectionMeta {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collection String    @unique @db.VarChar(100)
  icon       String?   @db.VarChar(100)
  note       String?   @db.VarChar(500)
  isHidden   Boolean   @default(false) @map("is_hidden")
  isSystem   Boolean   @default(false) @map("is_system")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  fields         FieldMeta[]
  relations      RelationMeta[] @relation("CollectionRelations")
  relatedInCount RelationMeta[] @relation("RelatedCollectionRelations")

  @@index([isHidden])
  @@map("collection_meta")
}

/// Metadata field per koleksi (tabel 2/3 Directus fields)
model FieldMeta {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  field        String   @db.VarChar(100)
  isRequired   Boolean  @default(false) @map("is_required")
  isHidden     Boolean  @default(false) @map("is_hidden")
  /// Special flags ala Directus (uuid, cast-tipe, dst.)
  special      String?  @db.VarChar(255)
  /// Metadata tambahan (ui options, validasi)
  meta         Json?    @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  collection CollectionMeta @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([collectionId, field])
  @@map("field_meta")
}

/// Metadata relasi antar koleksi (tabel 3/3 Directus relations)
model RelationMeta {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId        String   @map("collection_id") @db.Uuid
  field               String   @db.VarChar(100)
  relatedCollectionId String?  @map("related_collection_id") @db.Uuid
  /// M2O | O2M | M2M | M2A
  relationType        String   @map("relation_type") @db.VarChar(20)
  /// Aksi referential yang di-enforce saat DDL runtime (CASCADE/SET_NULL/...)
  onDeleteAction      String?  @map("on_delete_action") @db.VarChar(20)
  meta                Json?    @db.JsonB
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  collection        CollectionMeta  @relation("CollectionRelations", fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  relatedCollection CollectionMeta? @relation("RelatedCollectionRelations", fields: [relatedCollectionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([collectionId, field])
  @@index([relatedCollectionId])
  @@map("relation_meta")
}

// -----------------------------------------------------------------------------
// Activity Log (audit trail multi-tenant, bab 5.6)
// -----------------------------------------------------------------------------

/// Jejak aktivitas per Company (tenant isolation): login HRIS offline cache,
/// MFA reset, percobaan lintas tenant (security event), dst.
model ActivityLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  detail     Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("activity_logs")
}

// -----------------------------------------------------------------------------
// Notification & Flow Dispatcher (bab 5.8 — eksekusi oleh flow_worker_agent)
// -----------------------------------------------------------------------------

/// Flow otomasi webhook per Company; config (URL/secret) dienkripsi
/// Envelope AES-256-GCM di level aplikasi sebelum disimpan
model WebhookFlow {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  name         String    @db.VarChar(150)
  triggerEvent String    @map("trigger_event") @db.VarChar(100)
  /// Konfigurasi flow (target URL, header, payload template) — nilai sensitif
  /// terenkripsi app-side
  config       Json      @db.JsonB
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([companyId, isActive])
  @@index([triggerEvent])
  @@map("webhook_flows")
}

/// Channel notifikasi per Company (SMTP/Telegram/Webhook); osc_rest hanya
/// menulis antrean outbox — pengiriman asinkron oleh flow_worker_agent
model NotificationChannel {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String                  @map("company_id") @db.Uuid
  type        NotificationChannelType
  /// Config channel (SMTP password, bot token, webhook URL) — terenkripsi
  /// Envelope AES-256-GCM di level aplikasi
  config      Json                    @db.JsonB
  /// Filter event (email reset MFA, alert metrik, downtime, SIEM findings)
  eventFilter String[]                @default([]) @map("event_filter") @db.VarChar(100)
  isActive    Boolean                 @default(true) @map("is_active")
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?               @map("deleted_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  alertRules AlertRule[]

  @@unique([companyId, type])
  @@index([companyId, isActive])
  @@map("notification_channels")
}

// -----------------------------------------------------------------------------
// Agent Enrollment (bab 5.8 — one-time token terikat company)
// -----------------------------------------------------------------------------

/// Token enrollment one-time terikat Company. DB hanya menyimpan HASH token
/// (token mentah ditampilkan sekali di UI admin); single-use di-enforce via
/// usedAt + validasi TTL saat POST /api/v1/agents/enroll
model AgentEnrollmentToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  nodeType  NodeType? @map("node_type")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([companyId])
  @@index([expiresAt])
  @@map("agent_enrollment_tokens")
}

// =============================================================================
// PART 2 — ITAM & SERVICE DESK (pola Snipe-IT/GLPI: state machine status label,
//          checkout/checkin atomik, lisensi seat, tiket ITIL)
//          Semua model mengikat company_id (FK Restrict, terindeks) — bab 5.6
// =============================================================================

// -----------------------------------------------------------------------------
// Enum ITAM & Service Desk
// -----------------------------------------------------------------------------

/// Tipe kategori item (Snipe-IT category_type + kategori ITIL GLPI)
enum CategoryType {
  ASSET
  ACCESSORY
  COMPONENT
  CONSUMABLE
  LICENSE
  TICKET

  @@map("category_type")
}

/// Kelompok state machine status Snipe-IT
/// (deployable = !assigned_to && !deleted && deployable && !archived)
enum StatusLabelType {
  DEPLOYABLE
  PENDING
  ARCHIVED

  @@map("status_label_type")
}

/// Status fisik/logis node (ala NetBox Device status)
enum AssetStatus {
  ACTIVE
  PLANNED
  STAGED
  OFFLINE
  FAILED
  DECOMMISSIONED

  @@map("asset_status")
}

/// Aksi log checkout/checkin aset (Snipe-IT action_logs)
enum CheckoutAction {
  CHECKOUT
  CHECKIN

  @@map("checkout_action")
}

/// Mode lisensi perangkat lunak
enum LicenseType {
  PERPETUAL
  SUBSCRIPTION
  OEM
  VOLUME

  @@map("license_type")
}

/// Status tiket mengikuti state int GLPI (1=new .. 8=under approval)
enum TicketStatus {
  NEW
  ASSIGNED
  PLANNED
  PENDING
  SOLVED
  CLOSED
  ACCEPTED
  UNDER_APPROVAL

  @@map("ticket_status")
}

enum TicketPriority {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH

  @@map("ticket_priority")
}

enum TicketType {
  INCIDENT
  REQUEST

  @@map("ticket_type")
}

// -----------------------------------------------------------------------------
// Master referensi ITAM (semua unique per company)
// -----------------------------------------------------------------------------

/// Unit organisasi per Company (GLPI departments)
model Department {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  name          String    @db.VarChar(150)
  notes         String?   @db.VarChar(500)
  managerUserId String?   @map("manager_user_id") @db.Uuid
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  manager User?   @relation("DepartmentManager", fields: [managerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  assets  Asset[]
  tickets Ticket[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("departments")
}

/// Lokasi fisik per Company (Snipe-IT locations), tree via parent_id
model Location {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(150)
  address   String?   @db.VarChar(300)
  city      String?   @db.VarChar(100)
  parentId  String?   @map("parent_id") @db.Uuid
  notes     String?   @db.VarChar(500)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent   Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children Location[] @relation("LocationTree")

  assets             Asset[]
  checkoutLogTargets AssetCheckoutLog[]

  @@unique([companyId, name])
  @@index([parentId])
  @@index([companyId, isActive])
  @@map("locations")
}

/// Kategori item per Company (Snipe-IT categories; type termasuk TICKET untuk ITIL)
model Category {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  name      String       @db.VarChar(150)
  type      CategoryType @map("type")
  notes     String?      @db.VarChar(500)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assetModels AssetModel[]
  tickets     Ticket[]

  @@unique([companyId, type, name])
  @@index([companyId, type])
  @@map("categories")
}

/// Pabrikan per Company (Snipe-IT manufacturers)
model Manufacturer {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  name         String    @db.VarChar(200)
  supportEmail String?   @map("support_email") @db.VarChar(255)
  supportPhone String?   @map("support_phone") @db.VarChar(50)
  supportUrl   String?   @map("support_url") @db.VarChar(500)
  notes        String?   @db.VarChar(500)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assetModels AssetModel[]
  licenses    SoftwareLicense[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("manufacturers")
}

/// Pemasok/vendor per Company (Snipe-IT suppliers)
model Supplier {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  name         String    @db.VarChar(200)
  contactName  String?   @map("contact_name") @db.VarChar(150)
  contactEmail String?   @map("contact_email") @db.VarChar(255)
  contactPhone String?   @map("contact_phone") @db.VarChar(50)
  address      String?   @db.VarChar(300)
  websiteUrl   String?   @map("website_url") @db.VarChar(500)
  notes        String?   @db.VarChar(500)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assets   Asset[]
  licenses SoftwareLicense[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("suppliers")
}

/// Status label = state machine aset ala Snipe-IT
/// (availableForCheckout = !assigned_to && !deleted && deployable && !archived)
model StatusLabel {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String          @map("company_id") @db.Uuid
  name      String          @db.VarChar(150)
  type      StatusLabelType
  color     String?         @db.VarChar(20)
  notes     String?         @db.VarChar(500)
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?       @map("deleted_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assets Asset[]

  @@unique([companyId, name])
  @@index([companyId, type])
  @@map("status_labels")
}

/// Model perangkat (ala Snipe-IT models / NetBox device types) — PROTECT bila
/// masih dipakai Asset (pola NetBox: device_type tidak boleh terhapus diam-diam)
model AssetModel {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  name           String    @db.VarChar(200)
  modelNumber    String?   @map("model_number") @db.VarChar(150)
  categoryId     String    @map("category_id") @db.Uuid
  manufacturerId String    @map("manufacturer_id") @db.Uuid
  eolMonths      Int?      @map("eol_months")
  notes          String?   @db.VarChar(500)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  manufacturer Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assets Asset[]

  @@unique([companyId, name])
  @@index([categoryId])
  @@index([manufacturerId])
  @@map("asset_models")
}

// -----------------------------------------------------------------------------
// Entitas induk: Asset / ManagedNode (reengineering.md bab 3)
// -----------------------------------------------------------------------------

/// Entitas induk server / network device / workstation — hub FK tunggal bagi
/// seluruh modul (ITAM, DCIM, telemetry P3, PAM P3). Integrasi Snipe-IT/GLPI/
/// NetBox: state machine (statusLabel + status), inventaris agent-driven
/// (isDynamic, lastSeenAt, source), hierarki lokasi (site + locationPath).
/// Validasi koherensi (checkout availability, unique partial hostname/serial)
/// di-enforce app-level di osc_rest (transaction + SELECT ... FOR UPDATE).
model Asset {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String      @map("company_id") @db.Uuid
  name             String      @db.VarChar(150)
  assetTag         String      @map("asset_tag") @db.VarChar(100)
  nodeType         NodeType    @default(HOST) @map("node_type")
  status           AssetStatus @default(ACTIVE)
  hostname         String?     @db.VarChar(255)
  fqdn             String?     @db.VarChar(255)
  mgmtIp           String?     @map("mgmt_ip") @db.Inet
  serialNumber     String?     @map("serial_number") @db.VarChar(255)
  assetModelId     String      @map("asset_model_id") @db.Uuid
  statusLabelId    String      @map("status_label_id") @db.Uuid
  siteId           String?     @map("site_id") @db.Uuid
  departmentId     String?     @map("department_id") @db.Uuid
  locationId       String?     @map("location_id") @db.Uuid
  supplierId       String?     @map("supplier_id") @db.Uuid
  assignedToUserId String?     @map("assigned_to_user_id") @db.Uuid
  locationPath     String?     @map("location_path") @db.VarChar(500)
  purchaseDate     DateTime?   @map("purchase_date") @db.Date
  purchaseCost     Decimal?    @map("purchase_cost") @db.Decimal(12, 2)
  warrantyMonths   Int?        @map("warranty_months")
  lastSeenAt       DateTime?   @map("last_seen_at") @db.Timestamptz(3)
  isDynamic        Boolean     @default(false) @map("is_dynamic")
  source           String?     @db.VarChar(100)
  notes            String?     @db.Text
  metadata         Json?       @db.JsonB
  customFields     Json?       @map("custom_fields") @db.JsonB
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(3)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assetModel  AssetModel  @relation(fields: [assetModelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  statusLabel StatusLabel @relation(fields: [statusLabelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site        Site?       @relation(fields: [siteId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  location    Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supplier    Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignedTo  User?       @relation("AssetAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  checkoutLogs      AssetCheckoutLog[]
  hardwareSnapshots HardwareInventorySnapshot[]
  interfaces        DeviceInterface[]
  rackAllocations   RackUnitAllocation[]
  ipAddresses       IpAddress[]
  snmpProfile       SnmpDeviceProfile?
  tickets           Ticket[]
  licenseSeats      LicenseSeat[]

  // --- Part 3: Telemetry, Uptime, Infra Control, SecOps, PAM (relasi balik) ---
  uptimeMonitors         UptimeMonitor[]
  nginxNodes             NginxNode[]
  dockerHosts            DockerHost[]
  systemMetricSnapshots  SystemMetricSnapshot[]
  fimBaselineEvents      FimBaselineEvent[]
  securityAlertEvents    SecurityAlertEvent[]
  vulnerabilityFindings  VulnerabilityFinding[]
  complianceCheckResults ComplianceCheckResult[]
  pamVaultAccounts       PamVaultAccount[]

  @@unique([companyId, assetTag])
  @@index([companyId, nodeType])
  @@index([companyId, status])
  @@index([assetModelId])
  @@index([statusLabelId])
  @@index([siteId])
  @@index([departmentId])
  @@index([locationId])
  @@index([assignedToUserId])
  @@index([lastSeenAt])
  @@map("assets")
}

/// Log checkout/checkin aset (Snipe-IT action_logs; append-only timeline)
model AssetCheckoutLog {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String         @map("company_id") @db.Uuid
  assetId           String         @map("asset_id") @db.Uuid
  action            CheckoutAction
  actorUserId       String?        @map("actor_user_id") @db.Uuid
  targetUserId      String?        @map("target_user_id") @db.Uuid
  targetLocationId  String?        @map("target_location_id") @db.Uuid
  expectedCheckinAt DateTime?      @map("expected_checkin_at") @db.Timestamptz(3)
  notes             String?        @db.Text
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  company        Company   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor          User?     @relation("CheckoutLogActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  target         User?     @relation("CheckoutLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  targetLocation Location? @relation(fields: [targetLocationId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([assetId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([targetUserId])
  @@index([expectedCheckinAt])
  @@map("asset_checkout_logs")
}

// -----------------------------------------------------------------------------
// Lisensi perangkat lunak (Snipe-IT licenses + seats)
// -----------------------------------------------------------------------------

model SoftwareLicense {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  name           String      @db.VarChar(200)
  /// Kunci lisensi — disarankan dienkripsi Envelope AES-256-GCM app-side
  licenseKey     String?     @map("license_key") @db.VarChar(500)
  type           LicenseType @default(PERPETUAL) @map("type")
  seatsTotal     Int         @default(1) @map("seats_total")
  manufacturerId String?     @map("manufacturer_id") @db.Uuid
  supplierId     String?     @map("supplier_id") @db.Uuid
  purchaseDate   DateTime?   @map("purchase_date") @db.Date
  expiryDate     DateTime?   @map("expiry_date") @db.Date
  purchaseCost   Decimal?    @map("purchase_cost") @db.Decimal(12, 2)
  notes          String?     @db.VarChar(500)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  seats LicenseSeat[]

  @@unique([companyId, name])
  @@index([companyId, expiryDate])
  @@map("software_licenses")
}

/// Seat lisensi individual (claim/assign atomik ala Snipe-IT checkout seat)
model LicenseSeat {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  licenseId       String   @map("license_id") @db.Uuid
  seatNumber      Int      @map("seat_number")
  assignedUserId  String?  @map("assigned_user_id") @db.Uuid
  assignedAssetId String?  @map("assigned_asset_id") @db.Uuid
  notes           String?  @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  license       SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignedTo    User?           @relation(fields: [assignedUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignedAsset Asset?          @relation(fields: [assignedAssetId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([licenseId, seatNumber])
  @@index([companyId])
  @@index([assignedUserId])
  @@index([assignedAssetId])
  @@map("license_seats")
}

// -----------------------------------------------------------------------------
// Inventaris perangkat keras agent-driven (GLPI inventory snapshots)
// -----------------------------------------------------------------------------

/// Snapshot inventaris hardware per aset (append-only, time-series) — diproduksi
/// agent enrollment / host_telemetry (field-locking GLPI). Retensi mengikuti
/// policy bab 5.8 (batch purge terjadwal).
model HardwareInventorySnapshot {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  assetId           String   @map("asset_id") @db.Uuid
  collectedAt       DateTime @default(now()) @map("collected_at") @db.Timestamptz(3)
  cpuModel          String?  @map("cpu_model") @db.VarChar(200)
  cpuCores          Int?     @map("cpu_cores")
  memoryTotalBytes  BigInt?  @map("memory_total_bytes")
  storageTotalBytes BigInt?  @map("storage_total_bytes")
  osName            String?  @map("os_name") @db.VarChar(150)
  osVersion         String?  @map("os_version") @db.VarChar(100)
  /// Payload inventaris mentah (komponen, disk, NIC) — GLPI glpi_items_* generik
  payload           Json     @db.JsonB

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([assetId, collectedAt(sort: Desc)])
  @@index([companyId, collectedAt(sort: Desc)])
  @@map("hardware_inventory_snapshots")
}

// -----------------------------------------------------------------------------
// Service Desk / Helpdesk ITIL (GLPI tickets + followups)
// -----------------------------------------------------------------------------

model Ticket {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  /// Nomor tiket per company (sequence app-generated, pola GLPI tickets_id)
  code            String         @db.VarChar(50)
  title           String         @db.VarChar(300)
  description     String?        @db.Text
  type            TicketType     @default(INCIDENT) @map("type")
  status          TicketStatus   @default(NEW)
  priority        TicketPriority @default(MEDIUM)
  categoryId      String?        @map("category_id") @db.Uuid
  assetId         String?        @map("asset_id") @db.Uuid
  requesterUserId String?        @map("requester_user_id") @db.Uuid
  requesterEmail  String?        @map("requester_email") @db.VarChar(255)
  assigneeUserId  String?        @map("assignee_user_id") @db.Uuid
  openedAt        DateTime       @default(now()) @map("opened_at") @db.Timestamptz(3)
  dueAt           DateTime?      @map("due_at") @db.Timestamptz(3)
  resolvedAt      DateTime?      @map("resolved_at") @db.Timestamptz(3)
  closedAt        DateTime?      @map("closed_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  asset     Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  requester User?     @relation("TicketRequester", fields: [requesterUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignee  User?     @relation("TicketAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  followups    TicketFollowup[]
  department   Department?      @relation(fields: [departmentId], references: [id])
  departmentId String?          @db.Uuid

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, openedAt(sort: Desc)])
  @@index([assigneeUserId])
  @@index([assetId])
  @@index([dueAt])
  @@map("tickets")
}

/// Follow-up tiket (ITIL timeline; isPrivate = catatan internal teknisi)
model TicketFollowup {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  authorUserId String?  @map("author_user_id") @db.Uuid
  body         String   @db.Text
  isPrivate    Boolean  @default(false) @map("is_private")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author  User?   @relation(fields: [authorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([ticketId, createdAt(sort: Desc)])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("ticket_followups")
}

// =============================================================================
// PART 2 — DCIM & IPAM (pola NetBox/LibreNMS: path enumeration app-side,
//          inet/cidr + GIST via migration SQL, uniqueness app-level, SNMP
//          polling profile + delta/rate snapshot time-series)
//          Semua model mengikat company_id (FK Restrict, terindeks) — bab 5.6
// =============================================================================

// -----------------------------------------------------------------------------
// Enum DCIM & IPAM
// -----------------------------------------------------------------------------

/// Sisi mounting pada rack (front/rear face ala NetBox)
enum RackFace {
  FRONT
  REAR

  @@map("rack_face")
}

/// Status kabel fisik (ala NetBox Cable status)
enum CableStatus {
  CONNECTED
  PLANNED
  DECOMMISSIONING

  @@map("cable_status")
}

/// Status VLAN
enum VlanStatus {
  ACTIVE
  RESERVED
  DEPRECATED

  @@map("vlan_status")
}

/// Status prefix (CONTAINER = prefix induk ala NetBox container prefix)
enum PrefixStatus {
  ACTIVE
  RESERVED
  CONTAINER
  DEPRECATED

  @@map("prefix_status")
}

/// Status alamat IP
enum IpAddressStatus {
  ACTIVE
  RESERVED
  DEPRECATED
  DHCP
  SLAAC

  @@map("ip_address_status")
}

/// Versi protokol SNMP (LibreNMS device polling)
enum SnmpVersion {
  V1
  V2C
  V3

  @@map("snmp_version")
}

// -----------------------------------------------------------------------------
// DCIM: Site -> Rack -> RackUnitAllocation, DeviceInterface, CableConnection
// -----------------------------------------------------------------------------

/// Site/datacenter per Company (ala NetBox Site; hierarki region via path
/// enumeration app-side, bukan ltree Prisma)
model Site {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(150)
  code      String?   @db.VarChar(50)
  address   String?   @db.VarChar(300)
  city      String?   @db.VarChar(100)
  latitude  Decimal?  @db.Decimal(9, 6)
  longitude Decimal?  @db.Decimal(9, 6)
  notes     String?   @db.VarChar(500)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  racks      Rack[]
  assets     Asset[]
  vlans      Vlan[]
  ipPrefixes IpPrefix[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("sites")
}

/// Rak fisik per Site (ala NetBox Rack; uHeight = kapasitas unit)
model Rack {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  name      String   @db.VarChar(100)
  uHeight   Int      @default(42) @map("u_height")
  model     String?  @db.VarChar(150)
  notes     String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  allocations RackUnitAllocation[]

  @@unique([companyId, siteId, name])
  @@index([siteId])
  @@map("racks")
}

/// Okupansi unit rack per aset (validasi overlap & kapasitas di app-level
/// osc_rest dengan transaksi + SELECT ... FOR UPDATE — pola bab 3)
model RackUnitAllocation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  rackId     String   @map("rack_id") @db.Uuid
  assetId    String   @map("asset_id") @db.Uuid
  unitNumber Int      @map("unit_number")
  face       RackFace @default(FRONT)
  notes      String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rack    Rack    @relation(fields: [rackId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([rackId, unitNumber, face])
  @@index([assetId])
  @@index([companyId])
  @@map("rack_unit_allocations")
}

/// Interface jaringan per aset (ala NetBox Interface; type = slug NetBox
/// e.g. "1000base-t", "10gbase-x-sfp+")
model DeviceInterface {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  name        String   @db.VarChar(100)
  type        String   @default("ethernet") @db.VarChar(50)
  macAddress  String?  @map("mac_address") @db.VarChar(50)
  mtu         Int?
  speedMbps   Int?     @map("speed_mbps")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  description String?  @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  ipAddresses     IpAddress[]
  cableEndA       CableConnection[]         @relation("CableEndA")
  cableEndB       CableConnection[]         @relation("CableEndB")
  metricSnapshots InterfaceMetricSnapshot[]

  @@unique([assetId, name])
  @@index([companyId, assetId])
  @@map("device_interfaces")
}

/// Koneksi kabel fisik A<->B (uniqueness satu-termination-satu-cable di-enforce
/// app-level ala NetBox; CablePath JSONB menyusul di P3 bila diperlukan)
model CableConnection {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  label     String?     @db.VarChar(150)
  type      String?     @db.VarChar(50)
  status    CableStatus @default(PLANNED)
  portAId   String      @map("port_a_id") @db.Uuid
  portBId   String      @map("port_b_id") @db.Uuid
  lengthM   Decimal?    @map("length_m") @db.Decimal(8, 2)
  notes     String?     @db.VarChar(500)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  portA   DeviceInterface @relation("CableEndA", fields: [portAId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  portB   DeviceInterface @relation("CableEndB", fields: [portBId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([companyId, status])
  @@index([portAId])
  @@index([portBId])
  @@map("cable_connections")
}

// -----------------------------------------------------------------------------
// IPAM: Vlan -> IpPrefix -> IpAddress
// -----------------------------------------------------------------------------

/// VLAN per Company (ala NetBox VLAN; vid 1..4094 divalidasi app-level)
model Vlan {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String     @map("company_id") @db.Uuid
  vid         Int
  name        String     @db.VarChar(150)
  status      VlanStatus @default(ACTIVE)
  siteId      String?    @map("site_id") @db.Uuid
  description String?    @db.VarChar(300)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site    Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  ipPrefixes IpPrefix[]

  @@unique([companyId, vid])
  @@index([companyId, siteId])
  @@map("vlans")
}

/// Prefix IP (cidr disimpan VarChar; GIST index pada cast inet dibuat via
/// migration SQL — Prisma tidak mengekspose cidr/GIST). Overlap containment
/// divalidasi app-level (pola NetBox).
model IpPrefix {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  /// CIDR notation, e.g. "10.10.0.0/24"
  prefix      String       @db.VarChar(64)
  status      PrefixStatus @default(ACTIVE)
  siteId      String?      @map("site_id") @db.Uuid
  vlanId      String?      @map("vlan_id") @db.Uuid
  isPool      Boolean      @default(false) @map("is_pool")
  description String?      @db.VarChar(300)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  site    Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  vlan    Vlan?   @relation(fields: [vlanId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  ipAddresses IpAddress[]

  @@unique([companyId, prefix])
  @@index([siteId])
  @@index([vlanId])
  @@map("ip_prefixes")
}

/// Alamat IP individual (tipe native INET; unique per company) — assignment ke
/// interface divalidasi app-level agar tenant interface == tenant IP
model IpAddress {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  address     String          @db.Inet
  status      IpAddressStatus @default(ACTIVE)
  prefixId    String?         @map("prefix_id") @db.Uuid
  interfaceId String?         @map("interface_id") @db.Uuid
  isGateway   Boolean         @default(false) @map("is_gateway")
  dnsName     String?         @map("dns_name") @db.VarChar(255)
  description String?         @db.VarChar(300)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  prefix    IpPrefix?        @relation(fields: [prefixId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  interface DeviceInterface? @relation(fields: [interfaceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  asset     Asset?           @relation(fields: [assetId], references: [id])
  assetId   String?          @db.Uuid

  @@unique([companyId, address])
  @@index([prefixId])
  @@index([interfaceId])
  @@index([status])
  @@map("ip_addresses")
}

// -----------------------------------------------------------------------------
// Network telemetry: SNMP profile + interface metric snapshot (LibreNMS)
// -----------------------------------------------------------------------------

/// Profil SNMP polling per aset network device — kredensial (community v1/v2c,
/// auth/priv v3) TIDAK pernah plaintext: Envelope AES-256-GCM app-level (bytea)
model SnmpDeviceProfile {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String      @map("company_id") @db.Uuid
  assetId             String      @map("asset_id") @db.Uuid
  version             SnmpVersion @default(V2C)
  port                Int         @default(161)
  /// Community string v1/v2c — terenkripsi Envelope AES-256-GCM
  communityEncrypted  Bytes?      @map("community_encrypted")
  v3Username          String?     @map("v3_username") @db.VarChar(100)
  v3AuthProtocol      String?     @map("v3_auth_protocol") @db.VarChar(20)
  /// Auth passphrase v3 — terenkripsi Envelope AES-256-GCM
  v3AuthPassEncrypted Bytes?      @map("v3_auth_pass_encrypted")
  v3PrivProtocol      String?     @map("v3_priv_protocol") @db.VarChar(20)
  /// Priv passphrase v3 — terenkripsi Envelope AES-256-GCM
  v3PrivPassEncrypted Bytes?      @map("v3_priv_pass_encrypted")
  pollIntervalSeconds Int         @default(300) @map("poll_interval_seconds")
  lastPolledAt        DateTime?   @map("last_polled_at") @db.Timestamptz(3)
  isActive            Boolean     @default(true) @map("is_active")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([assetId])
  @@index([companyId, isActive])
  @@index([lastPolledAt])
  @@map("snmp_device_profiles")
}

/// Snapshot metrik interface (time-series append-only, delta/rate dihitung
/// poller ala LibreNMS) — composite index (interface_id, collected_at DESC);
/// retensi 30–90 hari via job terjadwal (bab 5.8), kandidat partitioning
/// range bulanan pada collected_at.
model InterfaceMetricSnapshot {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  interfaceId       String   @map("interface_id") @db.Uuid
  collectedAt       DateTime @default(now()) @map("collected_at") @db.Timestamptz(3)
  inOctets          BigInt
  outOctets         BigInt
  inUnicastPackets  BigInt?  @map("in_unicast_packets")
  outUnicastPackets BigInt?  @map("out_unicast_packets")
  inErrors          BigInt?  @map("in_errors")
  outErrors         BigInt?  @map("out_errors")
  inDiscards        BigInt?  @map("in_discards")
  outDiscards       BigInt?  @map("out_discards")
  /// Hasil komputasi delta/rate poller (bits per second)
  inRateBps         BigInt?  @map("in_rate_bps")
  outRateBps        BigInt?  @map("out_rate_bps")

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  interface DeviceInterface @relation(fields: [interfaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([interfaceId, collectedAt(sort: Desc)])
  @@index([companyId, collectedAt(sort: Desc)])
  @@map("interface_metric_snapshots")
}

// =============================================================================
// PART 3 — TELEMETRY, UPTIME, NGINX, DOCKER, ALERTING, SECOPS, PAM, FILE ASSET
//          (pola Uptime Kuma / Nginx UI / Dockge+Arcane / Beszel / Wazuh /
//           JumpServer). Semua model mengikat company_id (FK Restrict,
//           terindeks) — bab 5.6 Strict Tenant Isolation.
// =============================================================================

// -----------------------------------------------------------------------------
// Enum Part 3
// -----------------------------------------------------------------------------

/// Tipe monitor uptime (polymorphic ala Uptime Kuma; detail di config JSONB)
enum UptimeMonitorType {
  HTTP
  HTTPS
  TCP
  ICMP
  DNS
  KEYWORD
  PUSH

  @@map("uptime_monitor_type")
}

/// Status heartbeat monitor (Uptime Kuma heartbeat status)
enum HeartbeatStatus {
  UP
  DOWN
  PENDING
  MAINTENANCE

  @@map("heartbeat_status")
}

/// Status virtual host dalam pipeline Nginx UI
/// (validasi sandbox -> applied -> gagal -> rollback)
enum NginxVhostStatus {
  DRAFT
  TESTING
  APPLIED
  FAILED
  ROLLED_BACK

  @@map("nginx_vhost_status")
}

/// Status kehadiran node agent (Nginx node / Docker host polling)
enum NodeOnlineStatus {
  ONLINE
  OFFLINE
  UNKNOWN

  @@map("node_online_status")
}

/// Status drift Compose stack (Arcane/Dockge: file vs state runtime)
enum DriftStatus {
  IN_SYNC
  DRIFTED
  UNKNOWN

  @@map("drift_status")
}

/// Operator pembanding rule alert (Beszel-style hysteresis)
enum AlertOperator {
  GT
  GTE
  LT
  LTE
  EQ
  NEQ

  @@map("alert_operator")
}

/// Tingkat keparahan alert (notif event_filter "alert_metrik", bab 5.8)
enum AlertSeverity {
  INFO
  WARNING
  CRITICAL

  @@map("alert_severity")
}

/// Status lifecycle alert (firing -> resolved; histeresis app-level)
enum AlertState {
  FIRING
  RESOLVED

  @@map("alert_state")
}

/// Tipe event FIM dual-event Wazuh (realtime inotify + scheduled checksum)
enum FimEventType {
  CREATED
  MODIFIED
  DELETED
  ATTRIBUTE_CHANGED

  @@map("fim_event_type")
}

/// Sumber deteksi FIM (dual-event: inotify realtime vs scan terjadwal)
enum FimDetectionSource {
  REALTIME
  SCHEDULED

  @@map("fim_detection_source")
}

/// Tingkat keparahan temuan keamanan (SIEM alert, CVE, SCA — skala Wazuh)
enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("security_severity")
}

/// Status penanganan temuan CVE (decide: fix / accept / false positive)
enum VulnerabilityStatus {
  OPEN
  FIXED
  ACCEPTED
  FALSE_POSITIVE

  @@map("vulnerability_status")
}

/// Hasil compliance check / SCA (Wazuh SCA; CIS benchmark pass/fail)
enum ComplianceStatus {
  PASS
  FAIL
  ERROR
  SKIPPED

  @@map("compliance_status")
}

/// Tipe akun vault PAM (JumpServer asset permission)
enum PamAccountType {
  SSH_PASSWORD
  SSH_KEY
  DATABASE
  HTTP_ENDPOINT

  @@map("pam_account_type")
}

/// Status sesi PAM (authorize -> active -> closed / denied / expired)
enum PamSessionStatus {
  REQUESTED
  AUTHORIZED
  ACTIVE
  CLOSED
  DENIED
  EXPIRED

  @@map("pam_session_status")
}

/// Kategori file asset di RustFS (replay PAM, backup config, excel, lampiran)
enum FileAssetCategory {
  PAM_RECORDING
  CONFIG_BACKUP
  EXCEL_EXPORT
  ATTACHMENT

  @@map("file_asset_category")
}

/// Tier retensi snapshot metrik host (bab 5.8: 1m -> 30 hari, 10m -> 90 hari,
/// konfigurabel 30-90 hari)
enum MetricTier {
  TIER_1M
  TIER_10M

  @@map("metric_tier")
}

// -----------------------------------------------------------------------------
// Uptime & Status Page (pola Uptime Kuma: monitor polymorphic + heartbeat)
// -----------------------------------------------------------------------------

/// Monitor uptime per Company (polymorphic: http/tcp/icmp/dns/keyword/push —
/// konfigurasi detail di config JSONB). Terikat opsional ke Asset (ManagedNode)
/// untuk dashboard NOC; standalone boleh (target eksternal).
model UptimeMonitor {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  assetId         String?           @map("asset_id") @db.Uuid
  name            String            @db.VarChar(150)
  type            UptimeMonitorType @default(HTTP)
  /// Target monitor (URL, host:port, hostname DNS) — validasi SSRF app-level
  target          String            @db.VarChar(500)
  /// Konfigurasi polymorphic per tipe (headers, keyword, auth) — nilai sensitif
  /// terenkripsi Envelope AES-256-GCM app-level
  config          Json?             @db.JsonB
  intervalSeconds Int               @default(60) @map("interval_seconds")
  retries         Int               @default(1)
  /// Token one-time push heartbeat (mode PUSH); hash disimpan, bukan plaintext
  pushTokenHash   String?           @unique @map("push_token_hash") @db.VarChar(255)
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(3)

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset       Asset?              @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  heartbeats  UptimeHeartbeat[]
  statusPages StatusPageMonitor[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([assetId])
  @@map("uptime_monitors")
}

/// Heartbeat hasil eksekusi monitor (time-series append-only). Raw retensi
/// 30 hari default (bab 5.8); agregat stat bucket dihitung poller. Index
/// partial `important` dibuat via migration SQL (Prisma tidak expose partial).
model UptimeHeartbeat {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String          @map("company_id") @db.Uuid
  monitorId  String          @map("monitor_id") @db.Uuid
  recordedAt DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(3)
  status     HeartbeatStatus @default(PENDING)
  /// Latensi round-trip milidetik (NULL untuk status DOWN)
  pingMs     Int?            @map("ping_ms")
  /// Flag baris penting (transisi UP<->DOWN) — index partial via migration SQL
  important  Boolean         @default(false)
  msg        String?         @db.VarChar(500)

  company Company       @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  monitor UptimeMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([monitorId, recordedAt(sort: Desc)])
  @@index([companyId, recordedAt(sort: Desc)])
  @@map("uptime_heartbeats")
}

/// Halaman status publik per Company (aggregate monitor; slug akses publik)
model StatusPage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  slug        String    @db.VarChar(100)
  title       String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  isPublished Boolean   @default(false) @map("is_published")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  monitors StatusPageMonitor[]

  @@unique([companyId, slug])
  @@index([isPublished])
  @@map("status_pages")
}

/// Join m2m StatusPage <-> UptimeMonitor (urutan tampil di status page)
model StatusPageMonitor {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  statusPageId String   @map("status_page_id") @db.Uuid
  monitorId    String   @map("monitor_id") @db.Uuid
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  statusPage StatusPage    @relation(fields: [statusPageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  monitor    UptimeMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([statusPageId, monitorId])
  @@index([monitorId])
  @@index([companyId])
  @@map("status_page_monitors")
}

// -----------------------------------------------------------------------------
// Nginx Control Plane (pola Nginx UI: pipeline validasi -> history ->
//   atomic write -> nginx -t -> rollback -> reload)
// -----------------------------------------------------------------------------

/// Node Nginx terkelola (proxy ke agent infra_control pada ManagedNode).
/// Konfigurasi final di-backup ke RustFS (bucket osc-config-backups).
model NginxNode {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  assetId      String?          @map("asset_id") @db.Uuid
  name         String           @db.VarChar(150)
  /// Endpoint agent (host:port); kredensial agent via HMAC enrollment bab 5.8
  endpoint     String           @db.VarChar(255)
  configDir    String?          @map("config_dir") @db.VarChar(500)
  status       NodeOnlineStatus @default(UNKNOWN)
  nginxVersion String?          @map("nginx_version") @db.VarChar(50)
  lastSeenAt   DateTime?        @map("last_seen_at") @db.Timestamptz(3)
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(3)

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset        Asset?             @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  virtualHosts NginxVirtualHost[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([assetId])
  @@index([status])
  @@map("nginx_nodes")
}

/// Virtual host / server block Nginx. Konten config disimpan di DB untuk
/// preview + pointer RustFS; pipeline simpan (nginx -t sandbox) di-enforce
/// app-level osc_rest; status FAILED/ROLLED_BACK wajib menyimpan reason.
model NginxVirtualHost {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  nginxNodeId     String           @map("nginx_node_id") @db.Uuid
  serverName      String           @map("server_name") @db.VarChar(255)
  listenPort      Int              @default(80) @map("listen_port")
  status          NginxVhostStatus @default(DRAFT)
  /// Isi server block (gonginx AST verbatim preview)
  configContent   String           @map("config_content") @db.Text
  sslCertPath     String?          @map("ssl_cert_path") @db.VarChar(500)
  sslKeyPath      String?          @map("ssl_key_path") @db.VarChar(500)
  /// Pointer objek backup config di RustFS (bucket osc-config-backups)
  backupObjectKey String?          @map("backup_object_key") @db.VarChar(500)
  lastError       String?          @map("last_error") @db.VarChar(500)
  validatedAt     DateTime?        @map("validated_at") @db.Timestamptz(3)
  appliedAt       DateTime?        @map("applied_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(3)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  nginxNode NginxNode @relation(fields: [nginxNodeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([nginxNodeId, serverName, listenPort])
  @@index([companyId, status])
  @@map("nginx_virtual_hosts")
}

// -----------------------------------------------------------------------------
// Docker & Compose Control Plane (pola Dockge/Arcane: lifecycle + drift +
//   journal rollback; env berlapis; image update 2 lapis + admission lease)
// -----------------------------------------------------------------------------

/// Host Docker terkelola (daemon socket via agent infra_control)
model DockerHost {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  assetId        String?          @map("asset_id") @db.Uuid
  name           String           @db.VarChar(150)
  /// Endpoint daemon (unix:// atau tcp://) — hanya via agent, bukan langsung
  endpoint       String           @db.VarChar(255)
  dockerVersion  String?          @map("docker_version") @db.VarChar(50)
  status         NodeOnlineStatus @default(UNKNOWN)
  containerCount Int?             @map("container_count")
  lastSeenAt     DateTime?        @map("last_seen_at") @db.Timestamptz(3)
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(3)

  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset                    Asset?                    @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stacks                   ComposeStack[]
  containerMetricSnapshots ContainerMetricSnapshot[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([assetId])
  @@index([status])
  @@map("docker_hosts")
}

/// Compose stack per Docker host (Arcane/Dockge: deploy journal + rollback).
/// Nilai env sensitif TIDAK plaintext — env berlapis dienkripsi Envelope
/// AES-256-GCM app-level; file compose di-backup ke RustFS.
model ComposeStack {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String      @map("company_id") @db.Uuid
  dockerHostId    String      @map("docker_host_id") @db.Uuid
  name            String      @db.VarChar(150)
  workingDir      String      @map("working_dir") @db.VarChar(500)
  /// Isi compose.yaml ter-deploy (compose-go parse app-level)
  composeContent  String      @map("compose_content") @db.Text
  /// Env overrides terenkripsi Envelope AES-256-GCM (bytea)
  envEncrypted    Bytes?      @map("env_encrypted")
  driftStatus     DriftStatus @default(UNKNOWN) @map("drift_status")
  /// Pointer backup config di RustFS (bucket osc-config-backups)
  backupObjectKey String?     @map("backup_object_key") @db.VarChar(500)
  lastDeployedAt  DateTime?   @map("last_deployed_at") @db.Timestamptz(3)
  lastSyncedAt    DateTime?   @map("last_synced_at") @db.Timestamptz(3)
  lastError       String?     @map("last_error") @db.VarChar(500)
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(3)

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dockerHost DockerHost @relation(fields: [dockerHostId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([dockerHostId, name])
  @@index([companyId, driftStatus])
  @@map("compose_stacks")
}

// -----------------------------------------------------------------------------
// Telemetry host & container (pola Beszel: delta keyed per interval, tier
//   1m -> 10m, retensi 30-90 hari; bab 5.8 Data Retention Policy)
// -----------------------------------------------------------------------------

/// Snapshot metrik host per interval polling agent host_telemetry_agent
/// (append-only, time-series). Kolom host_id = FK ke assets. Index komposit
/// (company_id, host_id, recorded_at) mendukung job retention cleanup 30-90
/// hari (DELETE batch per rentang waktu per tenant) dan grafik per host;
/// kandidat partitioning range bulanan pada recorded_at.
model SystemMetricSnapshot {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String     @map("company_id") @db.Uuid
  hostId         String     @map("host_id") @db.Uuid
  recordedAt     DateTime   @default(now()) @map("recorded_at") @db.Timestamptz(3)
  tier           MetricTier @default(TIER_1M)
  cpuUsagePct    Decimal?   @map("cpu_usage_pct") @db.Decimal(5, 2)
  load1          Decimal?   @db.Decimal(6, 2)
  load5          Decimal?   @db.Decimal(6, 2)
  load15         Decimal?   @db.Decimal(6, 2)
  memUsedBytes   BigInt?    @map("mem_used_bytes")
  memTotalBytes  BigInt?    @map("mem_total_bytes")
  diskUsedBytes  BigInt?    @map("disk_used_bytes")
  diskTotalBytes BigInt?    @map("disk_total_bytes")
  netInBps       BigInt?    @map("net_in_bps")
  netOutBps      BigInt?    @map("net_out_bps")
  uptimeSeconds  BigInt?    @map("uptime_seconds")
  agentId        String?    @map("agent_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  host    Asset   @relation(fields: [hostId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([companyId, hostId, recordedAt])
  @@index([hostId, recordedAt(sort: Desc)])
  @@index([recordedAt])
  @@map("system_metric_snapshots")
}

/// Snapshot metrik container per Docker host (append-only). Index komposit
/// (company_id, host_id, recorded_at) untuk retention cleanup 30-90 hari.
model ContainerMetricSnapshot {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  hostId        String   @map("host_id") @db.Uuid
  /// Docker container ID (string hex 64) atau container name — bukan FK
  containerRef  String   @map("container_ref") @db.VarChar(100)
  containerName String?  @map("container_name") @db.VarChar(150)
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)
  cpuUsagePct   Decimal? @map("cpu_usage_pct") @db.Decimal(5, 2)
  memUsedBytes  BigInt?  @map("mem_used_bytes")
  memLimitBytes BigInt?  @map("mem_limit_bytes")
  netInBps      BigInt?  @map("net_in_bps")
  netOutBps     BigInt?  @map("net_out_bps")
  blockReadBps  BigInt?  @map("block_read_bps")
  blockWriteBps BigInt?  @map("block_write_bps")
  pids          Int?
  isRunning     Boolean  @default(true) @map("is_running")

  company Company    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  host    DockerHost @relation(fields: [hostId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([companyId, hostId, recordedAt])
  @@index([hostId, recordedAt(sort: Desc)])
  @@index([containerRef, recordedAt(sort: Desc)])
  @@index([recordedAt])
  @@map("container_metric_snapshots")
}

// -----------------------------------------------------------------------------
// Alerting (pola Beszel: histeresis + notif channel; bab 5.8 dispatcher)
// -----------------------------------------------------------------------------

/// Rule alert per Company: threshold metrik (host/container/uptime/FIM/CVE)
/// dengan operator + durasi (histeresis di-evaluasi app-level osc_rest)
model AlertRule {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String        @map("company_id") @db.Uuid
  name                  String        @db.VarChar(150)
  /// Sumber metrik, e.g. "system.cpu_pct", "container.mem_pct", "uptime.down",
  /// "fim.event", "vuln.cve" (dot-path tervalidasi app-level)
  metric                String        @db.VarChar(100)
  operator              AlertOperator @default(GT)
  threshold             Decimal       @db.Decimal(12, 2)
  /// Durasi kondisi bertahan sebelum firing (anti flapping)
  durationSeconds       Int           @default(60) @map("duration_seconds")
  severity              AlertSeverity @default(WARNING)
  /// Filter target opsional (host/container/tag) — JSON object
  targetFilter          Json?         @map("target_filter") @db.JsonB
  notificationChannelId String?       @map("notification_channel_id") @db.Uuid
  isActive              Boolean       @default(true) @map("is_active")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?     @map("deleted_at") @db.Timestamptz(3)

  company   Company              @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  channel   NotificationChannel? @relation(fields: [notificationChannelId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  histories AlertHistory[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([notificationChannelId])
  @@map("alert_rules")
}

/// Riwayat alert append-only (firing -> resolved; notif via outbox worker)
model AlertHistory {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  alertRuleId String        @map("alert_rule_id") @db.Uuid
  state       AlertState    @default(FIRING)
  severity    AlertSeverity @default(WARNING)
  /// Ref target yang beralarm (asset uuid / container ref / monitor id)
  targetRef   String?       @map("target_ref") @db.VarChar(150)
  value       Decimal?      @db.Decimal(12, 2)
  message     String?       @db.VarChar(500)
  firedAt     DateTime      @default(now()) @map("fired_at") @db.Timestamptz(3)
  resolvedAt  DateTime?     @map("resolved_at") @db.Timestamptz(3)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  alertRule AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([alertRuleId, firedAt(sort: Desc)])
  @@index([companyId, firedAt(sort: Desc)])
  @@index([resolvedAt])
  @@map("alert_histories")
}

// -----------------------------------------------------------------------------
// SecOps: SIEM/FIM/CVE/SCA (pola Wazuh 5.x: event store vs detector terpisah,
//   FIM dual-event + checksum, CVE feed matching, SCA compliance)
// -----------------------------------------------------------------------------

/// Event FIM (File Integrity Monitoring) dual-event per ManagedNode: sumber
/// realtime (inotify) + scheduled (checksum baseline). Baseline versioning
/// memungkinkan diff antar baseline; retensi mengikuti policy 30-90 hari.
model FimBaselineEvent {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  assetId          String             @map("asset_id") @db.Uuid
  path             String             @db.VarChar(1000)
  eventType        FimEventType       @map("event_type")
  detectionSource  FimDetectionSource @default(SCHEDULED) @map("detection_source")
  baselineVersion  Int                @default(1) @map("baseline_version")
  oldChecksum      String?            @map("old_checksum") @db.VarChar(64)
  newChecksum      String?            @map("new_checksum") @db.VarChar(64)
  /// Atribut lama/baru (mode, uid, gid, mtime, size) — diff app-level
  oldAttrs         Json?              @map("old_attrs") @db.JsonB
  newAttrs         Json?              @map("new_attrs") @db.JsonB
  sizeBytes        BigInt?            @map("size_bytes")
  detectedAt       DateTime           @default(now()) @map("detected_at") @db.Timestamptz(3)
  isResolved       Boolean            @default(false) @map("is_resolved")
  resolvedByUserId String?            @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?          @map("resolved_at") @db.Timestamptz(3)

  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset      Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resolvedBy User?   @relation("FimEventResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([companyId, assetId, detectedAt(sort: Desc)])
  @@index([assetId, path, detectedAt(sort: Desc)])
  @@index([isResolved])
  @@index([detectedAt])
  @@map("fim_baseline_events")
}

/// Security alert SIEM (detector terpisah dari event store; kandidat rule
/// Sigma/Syscheck Wazuh). Acknowledgement tercatat untuk audit SOC.
model SecurityAlertEvent {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String           @map("company_id") @db.Uuid
  assetId              String?          @map("asset_id") @db.Uuid
  ruleName             String           @map("rule_name") @db.VarChar(200)
  /// Kategori, e.g. "authentication", "malware", "web_attack"
  category             String?          @db.VarChar(100)
  severity             SecuritySeverity @default(MEDIUM)
  mitreTactic          String?          @map("mitre_tactic") @db.VarChar(100)
  mitreTechnique       String?          @map("mitre_technique") @db.VarChar(100)
  sourceIp             String?          @map("source_ip") @db.Inet
  /// Payload alert mentah (decoded fields Wazuh)
  payload              Json?            @db.JsonB
  detectedAt           DateTime         @default(now()) @map("detected_at") @db.Timestamptz(3)
  isAcknowledged       Boolean          @default(false) @map("is_acknowledged")
  acknowledgedByUserId String?          @map("acknowledged_by_user_id") @db.Uuid
  acknowledgedAt       DateTime?        @map("acknowledged_at") @db.Timestamptz(3)

  company        Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset          Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  acknowledgedBy User?   @relation("SecurityAlertAcknowledger", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([companyId, detectedAt(sort: Desc)])
  @@index([assetId, detectedAt(sort: Desc)])
  @@index([severity])
  @@index([isAcknowledged])
  @@index([detectedAt])
  @@map("security_alert_events")
}

/// Temuan CVE per aset (matching feed + inventory version matcher; dedupe
/// unique per asset+cve; status penanganan untuk triage SOC)
model VulnerabilityFinding {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String              @map("company_id") @db.Uuid
  assetId          String              @map("asset_id") @db.Uuid
  cveId            String              @map("cve_id") @db.VarChar(20)
  title            String              @db.VarChar(300)
  severity         SecuritySeverity    @default(MEDIUM)
  cvssScore        Decimal?            @map("cvss_score") @db.Decimal(3, 1)
  versionInstalled String?             @map("version_installed") @db.VarChar(150)
  versionFixed     String?             @map("version_fixed") @db.VarChar(150)
  status           VulnerabilityStatus @default(OPEN)
  sourceFeed       String?             @map("source_feed") @db.VarChar(100)
  firstDetectedAt  DateTime            @default(now()) @map("first_detected_at") @db.Timestamptz(3)
  lastDetectedAt   DateTime            @default(now()) @map("last_detected_at") @db.Timestamptz(3)
  resolvedAt       DateTime?           @map("resolved_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([assetId, cveId])
  @@index([companyId, status])
  @@index([companyId, severity])
  @@index([lastDetectedAt])
  @@map("vulnerability_findings")
}

/// Hasil compliance check / SCA per aset (CIS benchmark, policy ID Wazuh)
model ComplianceCheckResult {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  assetId   String           @map("asset_id") @db.Uuid
  /// Benchmark, e.g. "CIS Ubuntu 22.04 LTS L1"
  benchmark String           @db.VarChar(100)
  /// ID check dalam benchmark, e.g. "5.2.3"
  checkId   String           @map("check_id") @db.VarChar(50)
  title     String           @db.VarChar(300)
  status    ComplianceStatus @default(FAIL)
  severity  SecuritySeverity @default(MEDIUM)
  /// Bukti hasil (command output ringkas, expected/actual)
  evidence  Json?            @db.JsonB
  checkedAt DateTime         @default(now()) @map("checked_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([assetId, benchmark, checkId, checkedAt])
  @@index([companyId, assetId, checkedAt(sort: Desc)])
  @@index([companyId, status])
  @@index([checkedAt])
  @@map("compliance_check_results")
}

// -----------------------------------------------------------------------------
// PAM Bastion & Vault (pola JumpServer: vault 2 lapis Envelope AES-256-GCM,
//   ACL staging mfa/review/ticket, command filter, session recording RustFS)
// -----------------------------------------------------------------------------

/// Kebijakan akses PAM per Company (ACL staging JumpServer-style): wajib MFA
/// (mandatory, bab 5.3), step-up 15 menit, approval/ticket, command filter
/// deny/confirm/allow, batas durasi & rentang IP sumber
model PamAccessPolicy {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  name                String    @db.VarChar(150)
  /// Selalu true — PAM tidak menerima sesi tanpa MFA (bab 5.3); di-enforce
  /// app-level: 403 MFA_REQUIRED_FOR_PAM bila user.mfa_enabled == false
  mfaRequired         Boolean   @default(true) @map("mfa_required")
  /// Step-up OTP jika verifikasi TOTP terakhir > 15 menit
  stepUpWindowMinutes Int       @default(15) @map("step_up_window_minutes")
  approvalRequired    Boolean   @default(false) @map("approval_required")
  ticketRequired      Boolean   @default(false) @map("ticket_required")
  /// Command filter: { deny: [...], confirm: [...], allow: [...] }
  commandFilter       Json?     @map("command_filter") @db.JsonB
  /// CIDR allowlist sumber koneksi (Inet[] native PostgreSQL)
  allowedSourceCidrs  String[]  @default([]) @map("allowed_source_cidrs") @db.Inet
  maxSessionMinutes   Int       @default(120) @map("max_session_minutes")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(3)

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  accounts       PamVaultAccount[]
  pamSessionLogs PamSessionLog[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("pam_access_policies")
}

/// Akun kredensial terpusat per ManagedNode (JumpServer account). Secret
/// (password/key) TIDAK pernah plaintext — vault 2 lapis Envelope AES-256-GCM
/// (KEK master terpisah dari DEK per record, bab 5.3/audit-c §6).
model PamVaultAccount {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  assetId         String         @map("asset_id") @db.Uuid
  policyId        String?        @map("policy_id") @db.Uuid
  label           String         @db.VarChar(150)
  accountType     PamAccountType @default(SSH_PASSWORD) @map("account_type")
  username        String         @db.VarChar(150)
  /// Secret terenkripsi Envelope AES-256-GCM (password atau private key)
  secretEncrypted Bytes          @map("secret_encrypted")
  /// Port service target (default SSH 22)
  port            Int            @default(22)
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset       Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  policy      PamAccessPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sessionLogs PamSessionLog[]

  @@unique([assetId, username])
  @@index([companyId, isActive])
  @@index([policyId])
  @@map("pam_vault_accounts")
}

/// Log sesi PAM (audit immutable): authorize -> active -> closed; WS ticket
/// ephemeral disimpan sebagai hash; recording (.cast.gz/.mp4) diarsipkan ke
/// RustFS — DB hanya metadata + pointer object key (bab 5.8).
model PamSessionLog {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String           @map("company_id") @db.Uuid
  accountId          String           @map("account_id") @db.Uuid
  policyId           String?          @map("policy_id") @db.Uuid
  requestedByUserId  String?          @map("requested_by_user_id") @db.Uuid
  status             PamSessionStatus @default(REQUESTED)
  sourceIp           String?          @map("source_ip") @db.Inet
  /// Hash WS ticket ephemeral (ticket mentah tidak pernah disimpan)
  wsTicketHash       String?          @map("ws_ticket_hash") @db.VarChar(255)
  commandCount       Int              @default(0) @map("command_count")
  /// Pointer rekaman sesi di RustFS (bucket osc-pam-recordings)
  recordingObjectKey String?          @map("recording_object_key") @db.VarChar(500)
  deniedReason       String?          @map("denied_reason") @db.VarChar(300)
  startedAt          DateTime?        @map("started_at") @db.Timestamptz(3)
  endedAt            DateTime?        @map("ended_at") @db.Timestamptz(3)
  durationSeconds    Int?             @map("duration_seconds")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  account     PamVaultAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  policy      PamAccessPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  requestedBy User?            @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([accountId, startedAt(sort: Desc)])
  @@index([requestedByUserId])
  @@index([status])
  @@map("pam_session_logs")
}

// -----------------------------------------------------------------------------
// File Asset registry (metadata + pointer RustFS; DB tidak menyimpan blob)
// -----------------------------------------------------------------------------

/// Registry objek file di RustFS (S3): replay PAM, backup konfigurasi
/// nginx/compose, export excel, lampiran. DB hanya metadata + pointer —
/// integritas diverifikasi via sha256 saat download.
model FileAsset {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  category         FileAssetCategory @default(ATTACHMENT)
  bucket           String            @db.VarChar(100)
  objectKey        String            @map("object_key") @db.VarChar(500)
  fileName         String            @map("file_name") @db.VarChar(255)
  mimeType         String?           @map("mime_type") @db.VarChar(150)
  sizeBytes        BigInt            @map("size_bytes")
  sha256           String?           @db.VarChar(64)
  uploadedByUserId String?           @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([bucket, objectKey])
  @@index([companyId, category, createdAt(sort: Desc)])
  @@index([uploadedByUserId])
  @@map("file_assets")
}
