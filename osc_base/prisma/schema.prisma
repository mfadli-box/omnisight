// DRAFT CONTRACT — not production code.
// Belum boleh dipakai sampai gate G0 (dokumentasi 0.6) disetujui.
//
// Scope: fondasi schema `core`, `audit`, dan `platform` (WP-02).
// Model domain `asset`, `network`, `monitor`, `ops`, `service`, dan `content`
// ditambahkan pada migrasi berikutnya.
//
// Pembagian tanggung jawab (lihat technical/database/prisma-dan-migrasi.md):
// - Prisma: definisi tabel, kolom, index sederhana, riwayat migrasi.
// - SQL migrasi: RLS FORCE + policy, grant role aplikasi, foreign key komposit,
//   unique parsial (mis. WHERE deleted_at IS NULL), partisi bulanan
//   `core.login_attempts`, CHECK constraint, trigger, dan fungsi hash chain audit.
// - Prisma Client tidak dipakai saat runtime; Rust memakai SQLx.
//
// Target: Prisma 6.7.x. Pada versi ini `multiSchema` dan `postgresqlExtensions`
// masih preview; keduanya wajib untuk `@@schema`/`schemas` dan `@db.Citext`.
// Naikkan versi Prisma secara sadar dan perbarui blok generator saat upgrade.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "multiSchema"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  schemas      = ["core", "asset", "network", "monitor", "ops", "service", "content", "audit", "platform"]
  extensions   = [citext, ltree, pgcrypto]
}

// ===========================================================================
// core — organisasi
// ===========================================================================

model Company {
  id        String    @id @db.Uuid
  code      String    @unique @db.VarChar(32)
  name      String    @db.VarChar(160)
  legalName String?   @map("legal_name") @db.VarChar(240)
  status    String    @default("active") @db.VarChar(16)
  timezone  String    @default("Asia/Jakarta") @db.VarChar(64)
  locale    String    @default("en") @db.VarChar(16)
  settings  Json      @default("{}") @db.JsonB
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  areas          Area[]
  locations      Location[]
  roles          Role[]
  memberships    CompanyMembership[]
  hrisConnections HrisConnection[]
  vendors        Vendor[]
  files          AppFile[]
  apiKeys        ApiKey[]

  @@index([status])
  @@schema("core")
  @@map("companies")
}

model Area {
  id        String    @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  path      Unsupported("ltree")
  code      String    @db.VarChar(32)
  name      String    @db.VarChar(160)
  type      String    @default("branch") @db.VarChar(32)
  status    String    @default("active") @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company   Company    @relation(fields: [companyId], references: [id])
  locations Location[]

  @@unique([companyId, id])
  @@unique([companyId, code])
  @@index([companyId, parentId])
  @@index([companyId, status])
  @@schema("core")
  @@map("areas")
}

model Location {
  id        String    @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  areaId    String    @map("area_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  code      String    @db.VarChar(32)
  name      String    @db.VarChar(160)
  type      String    @default("site") @db.VarChar(32)
  address   Json      @default("{}") @db.JsonB
  latitude  Decimal?  @db.Decimal(9, 6)
  longitude Decimal?  @db.Decimal(9, 6)
  status    String    @default("active") @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  area    Area    @relation(fields: [areaId], references: [id])

  @@unique([companyId, areaId, id])
  @@unique([companyId, areaId, code])
  @@index([companyId, areaId, status])
  @@schema("core")
  @@map("locations")
}

// ===========================================================================
// core — pengguna dan membership
// ===========================================================================

model User {
  id               String    @id @db.Uuid
  email            String    @unique @db.Citext
  displayName      String    @map("display_name") @db.VarChar(160)
  status           String    @default("active") @db.VarChar(16)
  passwordHash     String?   @map("password_hash") @db.Text
  passwordUpdatedAt DateTime? @map("password_updated_at") @db.Timestamptz(6)
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  mfaSecretRef     String?   @map("mfa_secret_ref") @db.Text
  locale           String    @default("en") @db.VarChar(16)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  identities    UserIdentity[]
  memberships   CompanyMembership[]
  platformRoles UserPlatformRole[]
  sessions      Session[]

  @@index([status])
  @@schema("core")
  @@map("users")
}

model UserIdentity {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  provider        String    @db.VarChar(32)
  providerSubject String    @map("provider_subject") @db.VarChar(240)
  companyId       String?   @map("company_id") @db.Uuid
  emailAtProvider String?   @map("email_at_provider") @db.Citext
  metadata        Json      @default("{}") @db.JsonB
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  // RFC: NULL company_id means a global provider. PostgreSQL treats NULLs as
  // distinct; a partial unique index is added in SQL for the NULL case.
  @@unique([provider, companyId, providerSubject])
  @@index([userId])
  @@schema("core")
  @@map("user_identities")
}

model CompanyMembership {
  id            String    @id @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  employeeNo    String?   @map("employee_no") @db.VarChar(64)
  jobTitle      String?   @map("job_title") @db.VarChar(160)
  status        String    @default("active") @db.VarChar(16)
  defaultAreaId String?   @map("default_area_id") @db.Uuid
  joinedAt      DateTime  @map("joined_at") @db.Timestamptz(6)
  leftAt        DateTime? @map("left_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company          @relation(fields: [companyId], references: [id])
  user    User             @relation(fields: [userId], references: [id])
  roles   MembershipRole[]

  @@unique([companyId, userId])
  @@unique([companyId, employeeNo])
  @@index([companyId, status])
  @@index([userId])
  @@schema("core")
  @@map("company_memberships")
}

model MembershipRole {
  id           String    @id @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  scopeType    String    @map("scope_type") @db.VarChar(16)
  scopeId      String?   @map("scope_id") @db.Uuid
  grantedBy    String?   @map("granted_by") @db.Uuid
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  membership CompanyMembership @relation(fields: [membershipId], references: [id])
  role       Role              @relation(fields: [roleId], references: [id])

  @@unique([membershipId, roleId, scopeType, scopeId])
  @@index([roleId])
  @@index([scopeType, scopeId])
  @@schema("core")
  @@map("membership_roles")
}

model UserPlatformRole {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleCode  String    @map("role_code") @db.VarChar(32)
  grantedBy String?   @map("granted_by") @db.Uuid
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, roleCode])
  @@schema("core")
  @@map("user_platform_roles")
}

// ===========================================================================
// core — peran dan izin
// ===========================================================================

model Permission {
  id         String   @id @db.Uuid
  moduleCode String   @map("module_code") @db.VarChar(16)
  action     String   @db.VarChar(8)
  name       String   @db.VarChar(160)
  isSensitive Boolean @default(false) @map("is_sensitive")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@unique([moduleCode, action])
  @@schema("core")
  @@map("permissions")
}

model Role {
  id          String   @id @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  code        String   @db.VarChar(48)
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company    Company          @relation(fields: [companyId], references: [id])
  memberships MembershipRole[]
  permissions RolePermission[]

  @@unique([companyId, code])
  @@index([companyId, isSystem])
  @@schema("core")
  @@map("roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@schema("core")
  @@map("role_permissions")
}

// ===========================================================================
// core — sesi dan token
// ===========================================================================

model Session {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  activeCompanyId String?   @map("active_company_id") @db.Uuid
  deviceId        String?   @map("device_id") @db.VarChar(128)
  ip              String    @db.Inet
  userAgent       String    @map("user_agent") @db.Text
  authMethod      String    @map("auth_method") @db.VarChar(16)
  mfaAt           DateTime? @map("mfa_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt      DateTime  @map("last_seen_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason    String?   @map("revoke_reason") @db.VarChar(64)

  user         User           @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([activeCompanyId])
  @@index([expiresAt])
  @@schema("core")
  @@map("sessions")
}

model RefreshToken {
  id          String    @id @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  tokenHash   Bytes     @unique @map("token_hash") @db.ByteA
  familyId    String    @map("family_id") @db.Uuid
  rotatedFrom String?   @map("rotated_from") @db.Uuid
  issuedAt    DateTime  @map("issued_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  reason      String?   @db.VarChar(64)

  session Session @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([familyId])
  @@index([expiresAt])
  @@schema("core")
  @@map("refresh_tokens")
}

// ===========================================================================
// core — login attempt (partisi bulanan)
// ===========================================================================

// SQL migration converts this table to PARTITION BY RANGE (created_at).
// PostgreSQL requires the partition key in the primary key: @@id([id, createdAt]).
model LoginAttempt {
  id               String   @db.Uuid
  companyId        String?  @map("company_id") @db.Uuid
  identifierHash   Bytes    @map("identifier_hash") @db.ByteA
  identifierMasked String?  @map("identifier_masked") @db.VarChar(80)
  method           String   @db.VarChar(16)
  result           String   @db.VarChar(16)
  failureCode      String?  @map("failure_code") @db.VarChar(48)
  ip               String   @db.Inet
  userAgent        String   @map("user_agent") @db.Text
  requestId        String   @map("request_id") @db.Uuid
  latencyMs        Int      @map("latency_ms")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([id, createdAt])
  @@index([companyId, createdAt])
  @@index([identifierHash, createdAt])
  @@index([result, createdAt])
  @@schema("core")
  @@map("login_attempts")
}

// ===========================================================================
// core — HRIS
// ===========================================================================

model HrisConnection {
  id            String    @id @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  name          String    @db.VarChar(120)
  baseUrl       String    @map("base_url") @db.Text
  authType      String    @map("auth_type") @db.VarChar(24)
  credentialRef String    @map("credential_ref") @db.Text
  extraHeaders  Json      @default("{}") @map("extra_headers") @db.JsonB
  tlsPolicy     String    @default("verify_full") @map("tls_policy") @db.VarChar(24)
  timeoutMs     Int       @default(5000) @map("timeout_ms")
  maxRetries    Int       @default(1) @map("max_retries")
  status        String    @default("active") @db.VarChar(16)
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company        @relation(fields: [companyId], references: [id])
  rules   HrisLoginRule[]
  logs    HrisLoginLog[]

  @@index([companyId, status])
  @@schema("core")
  @@map("hris_connections")
}

model HrisLoginRule {
  id              String   @id @db.Uuid
  connectionId    String   @map("connection_id") @db.Uuid
  name            String   @db.VarChar(120)
  priority        Int      @default(100)
  isActive        Boolean  @default(true) @map("is_active")
  matchConditions Json     @default("{}") @map("match_conditions") @db.JsonB
  requestSpec     Json     @map("request_spec") @db.JsonB
  successWhen     Json     @map("success_when") @db.JsonB
  fieldMap        Json     @map("field_map") @db.JsonB
  roleMap         Json     @default("{}") @map("role_map") @db.JsonB
  failureMap      Json     @default("[]") @map("failure_map") @db.JsonB
  fallbackPolicy  Json     @default("{}") @map("fallback_policy") @db.JsonB
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  connection HrisConnection @relation(fields: [connectionId], references: [id])

  @@index([connectionId, isActive, priority])
  @@schema("core")
  @@map("hris_login_rules")
}

model HrisLoginLog {
  id             String   @id @db.Uuid
  connectionId   String   @map("connection_id") @db.Uuid
  ruleId         String?  @map("rule_id") @db.Uuid
  identifierHash Bytes    @map("identifier_hash") @db.ByteA
  result         String   @db.VarChar(16)
  httpStatus     Int?     @map("http_status")
  failureCode    String?  @map("failure_code") @db.VarChar(48)
  latencyMs      Int      @map("latency_ms")
  responseHash   Bytes?   @map("response_hash") @db.ByteA
  requestId      String   @map("request_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  connection HrisConnection @relation(fields: [connectionId], references: [id])

  @@index([connectionId, createdAt])
  @@index([result, createdAt])
  @@schema("core")
  @@map("hris_login_logs")
}

// ===========================================================================
// core — vendor, file, API key
// ===========================================================================

model Vendor {
  id        String    @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(160)
  category  String?   @db.VarChar(64)
  contact   Json      @default("{}") @db.JsonB
  status    String    @default("active") @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@schema("core")
  @@map("vendors")
}

model AppFile {
  id             String    @id @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  storageKey     String    @map("storage_key") @db.Text
  originalName   String    @map("original_name") @db.VarChar(255)
  mime           String    @db.VarChar(128)
  sizeBytes      BigInt    @map("size_bytes")
  sha256         Bytes     @db.ByteA
  classification String    @default("internal") @db.VarChar(16)
  uploadedBy     String    @map("uploaded_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@index([sha256])
  @@schema("core")
  @@map("files")
}

model ApiKey {
  id         String    @id @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  name       String    @db.VarChar(120)
  keyPrefix  String    @map("key_prefix") @db.VarChar(16)
  keyHash    Bytes     @unique @map("key_hash") @db.ByteA
  scopes     Json      @default("[]") @db.JsonB
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, keyPrefix])
  @@schema("core")
  @@map("api_keys")
}

// ===========================================================================
// audit — append-only trail
// ===========================================================================

// Append is performed by audit.append_event() in a SECURITY DEFINER function.
// The application role only holds INSERT and SELECT on this table.
model AuditEvent {
  id          String   @id @db.Uuid
  chainKey    String   @map("chain_key") @db.VarChar(64)
  seq         BigInt
  companyId   String?  @map("company_id") @db.Uuid
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(6)
  actorType   String   @map("actor_type") @db.VarChar(16)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorLabel  String?  @map("actor_label") @db.VarChar(160)
  action      String   @db.VarChar(64)
  moduleCode  String   @map("module_code") @db.VarChar(16)
  entityType  String   @map("entity_type") @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.Uuid
  scopeType   String?  @map("scope_type") @db.VarChar(16)
  scopeId     String?  @map("scope_id") @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  ip          String?  @db.Inet
  userAgent   String?  @map("user_agent") @db.Text
  before      Json?    @db.JsonB
  after       Json?    @db.JsonB
  metadata    Json     @default("{}") @db.JsonB
  prevHash    Bytes    @map("prev_hash") @db.ByteA
  hash        Bytes    @db.ByteA

  @@unique([chainKey, seq])
  @@index([companyId, occurredAt])
  @@index([entityType, entityId])
  @@index([actorUserId, occurredAt])
  @@schema("audit")
  @@map("audit_events")
}

model AuditChainHead {
  chainKey  String   @id @map("chain_key") @db.VarChar(64)
  lastSeq   BigInt   @default(0) @map("last_seq")
  lastHash  Bytes    @map("last_hash") @db.ByteA
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@schema("audit")
  @@map("audit_chain_heads")
}

model SecurityEvent {
  id             String    @id @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  source         String    @db.VarChar(32)
  externalRuleId String?   @map("external_rule_id") @db.VarChar(64)
  severity       String    @db.VarChar(16)
  title          String    @db.VarChar(200)
  description    String    @db.Text
  srcIp          String?   @map("src_ip") @db.Inet
  dstIp          String?   @map("dst_ip") @db.Inet
  agentRef       String?   @map("agent_ref") @db.VarChar(120)
  rawRef         String?   @map("raw_ref") @db.Text
  status         String    @default("new") @db.VarChar(16)
  assigneeUserId String?   @map("assignee_user_id") @db.Uuid
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, occurredAt])
  @@index([companyId, status, severity])
  @@schema("audit")
  @@map("security_events")
}

model AccessReview {
  id             String    @id @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  periodStart    DateTime  @map("period_start") @db.Date
  periodEnd      DateTime  @map("period_end") @db.Date
  status         String    @default("draft") @db.VarChar(16)
  reviewerUserId String    @map("reviewer_user_id") @db.Uuid
  dueAt          DateTime  @map("due_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  items AccessReviewItem[]

  @@index([companyId, status, dueAt])
  @@schema("audit")
  @@map("access_reviews")
}

model AccessReviewItem {
  id           String    @id @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  reviewId     String    @map("review_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  scopeType    String    @map("scope_type") @db.VarChar(16)
  scopeId      String?   @map("scope_id") @db.Uuid
  decision     String    @default("pending") @db.VarChar(16)
  decidedBy    String?   @map("decided_by") @db.Uuid
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(6)
  note         String?   @db.Text

  review AccessReview @relation(fields: [reviewId], references: [id])

  @@unique([reviewId, membershipId, roleId, scopeType, scopeId])
  @@index([companyId, decision])
  @@schema("audit")
  @@map("access_review_items")
}

model DataRetentionPolicy {
  id            String   @id @db.Uuid
  companyId     String?  @map("company_id") @db.Uuid
  dataClass     String   @map("data_class") @db.VarChar(32)
  retentionDays Int      @map("retention_days")
  action        String   @db.VarChar(16)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, dataClass])
  @@schema("audit")
  @@map("data_retention_policies")
}

// ===========================================================================
// platform — integrasi, webhook, setting, outbox, impersonasi
// ===========================================================================

model IntegrationEndpoint {
  id            String    @id @db.Uuid
  companyId     String?   @map("company_id") @db.Uuid
  kind          String    @db.VarChar(32)
  name          String    @db.VarChar(120)
  baseUrl       String    @map("base_url") @db.Text
  credentialRef String    @map("credential_ref") @db.Text
  config        Json      @default("{}") @db.JsonB
  status        String    @default("active") @db.VarChar(16)
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, name])
  @@index([companyId, kind, status])
  @@schema("platform")
  @@map("integration_endpoints")
}

model IntegrationLink {
  id            String    @id @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  integrationId String    @map("integration_id") @db.Uuid
  localType     String    @map("local_type") @db.VarChar(48)
  localId       String    @map("local_id") @db.Uuid
  externalType  String    @map("external_type") @db.VarChar(48)
  externalId    String    @map("external_id") @db.VarChar(160)
  syncDirection String    @map("sync_direction") @db.VarChar(16)
  status        String    @default("pending") @db.VarChar(16)
  lastSyncedAt  DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([integrationId, localType, localId])
  @@index([companyId, status])
  @@index([externalType, externalId])
  @@schema("platform")
  @@map("integration_links")
}

model Webhook {
  id             String    @id @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  name           String    @db.VarChar(120)
  url            String    @db.Text
  secretRef      String    @map("secret_ref") @db.Text
  events         Json      @default("[]") @db.JsonB
  enabled        Boolean   @default(true)
  lastDeliveryAt DateTime? @map("last_delivery_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  deliveries WebhookDelivery[]

  @@index([companyId, enabled])
  @@schema("platform")
  @@map("webhooks")
}

model WebhookDelivery {
  id           String    @id @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  webhookId    String    @map("webhook_id") @db.Uuid
  eventType    String    @map("event_type") @db.VarChar(64)
  payloadRef   String    @map("payload_ref") @db.Text
  status       String    @default("pending") @db.VarChar(16)
  attempt      Int       @default(1)
  responseCode Int?      @map("response_code")
  nextRetryAt  DateTime? @map("next_retry_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)

  webhook Webhook @relation(fields: [webhookId], references: [id])

  @@index([webhookId, status])
  @@index([companyId, createdAt])
  @@schema("platform")
  @@map("webhook_deliveries")
}

model Setting {
  id        String   @id @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  key       String   @db.VarChar(120)
  value     Json     @db.JsonB
  isSecret  Boolean  @default(false) @map("is_secret")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, key])
  @@schema("platform")
  @@map("settings")
}

model FeatureFlag {
  id        String   @id @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  key       String   @db.VarChar(120)
  enabled   Boolean  @default(false)
  config    Json     @default("{}") @db.JsonB
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, key])
  @@schema("platform")
  @@map("feature_flags")
}

model OutboxEvent {
  id            String    @id @db.Uuid
  companyId     String?   @map("company_id") @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(48)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(64)
  payload       Json      @default("{}") @db.JsonB
  status        String    @default("pending") @db.VarChar(16)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@index([companyId, createdAt])
  @@schema("platform")
  @@map("outbox_events")
}

model ImpersonationSession {
  id           String    @id @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  actorUserId  String    @map("actor_user_id") @db.Uuid
  targetUserId String    @map("target_user_id") @db.Uuid
  reason       String    @db.Text
  approvedBy   String?   @map("approved_by") @db.Uuid
  startedAt    DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(6)
  requestId    String    @map("request_id") @db.Uuid
  actionsCount Int       @default(0) @map("actions_count")

  @@index([companyId, startedAt])
  @@index([actorUserId, startedAt])
  @@schema("platform")
  @@map("impersonation_sessions")
}
