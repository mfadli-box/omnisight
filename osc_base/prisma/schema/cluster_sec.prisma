  agent_id     String?
  name         String
  display_name String?
  state        String?
  start_type   String?
  recorded_at  DateTime @default(now())

  @@index([agent_id])
}

model sec_syscollector_hotfix {
  id           String    @id @default(uuid())
  agent_id     String?
  hotfix_id    String
