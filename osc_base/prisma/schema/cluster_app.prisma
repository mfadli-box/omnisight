model app_module {
  id         String   @id @default(uuid())
  parent_id  String?
  code       String
  name       String
  path       String
  is_page    Boolean  @default(true)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  parent     app_module?          @relation("modular", fields: [parent_id], references: [id])
  children   app_module[]         @relation("modular")
  companies  app_company_module[]
  privileges app_user_privilege[]

  @@unique([code])
  @@index([parent_id])
}

model app_company {
  id         String   @id @default(uuid())
  code       String
  name       String
  valuta     String   @default("IDR")
  vat_id     String?
  reg_no     String?
  address    String?
  tax_office String?
  hris_link  String?
  is_active  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  modules app_company_module[]
  areas   app_company_area[]
  users   app_user_company[]

  @@unique([code])
}

model app_company_module {
  id         String   @id @default(uuid())
  company_id String
  module_id  String
  is_active  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  company app_company @relation(fields: [company_id], references: [id])
  module  app_module  @relation(fields: [module_id], references: [id])

  @@unique([company_id, module_id])
}

model app_company_area {
  id          String   @id @default(uuid())
  company_id  String
  code        String
  name        String
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  company app_company     @relation(fields: [company_id], references: [id])
  users   app_user_area[]

  @@unique([company_id, code])
  @@index([company_id])
}

model app_user {
  id              String    @id @default(uuid())
  username        String
  email           String
  password        String
  fullname        String
  phone           String?
  company_id      String    @default("")
  employee_id     String?
  location_id     String?
  department_id   String?
  division_id     String?
  role            String    @default("staff")
  job             String    @default("")
  key             String    @default("")
  is_admin        Boolean   @default(false)
  is_hris         Boolean   @default(false)
  is_active       Boolean   @default(false)
  is_totp_enabled Boolean   @default(false)
  totp_secret     String?
  locked_until    DateTime?
  failed_attempts Int       @default(0)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now())

  companies       app_user_company[]
  areas           app_user_area[]
  actions         app_user_action[]
  tokens          app_user_token[]
  sessions        app_user_session[]
  approval_signs  app_approval_sign[]
  signature_flags app_signature_flag[]

  @@unique([company_id, username])
}

model app_user_company {
  id         String   @id @default(uuid())
  user_id    String
  company_id String
  is_active  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  user       app_user             @relation(fields: [user_id], references: [id])
  company    app_company          @relation(fields: [company_id], references: [id])
  privileges app_user_privilege[]

  @@unique([user_id, company_id])
}

model app_user_area {
  id              String   @id @default(uuid())
  user_id         String
  company_area_id String
  is_active       Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now())

  user         app_user         @relation(fields: [user_id], references: [id])
  company_area app_company_area @relation(fields: [company_area_id], references: [id])

  @@unique([user_id, company_area_id])
}

model app_user_privilege {
  id              String   @id @default(uuid())
  user_company_id String
  module_id       String
  level           String   @default("HIDE")
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now())

  user_company app_user_company @relation(fields: [user_company_id], references: [id])
  module       app_module       @relation(fields: [module_id], references: [id])

  @@unique([user_company_id, module_id])
}

model app_user_session {
  id            String    @id @default(uuid())
  user_id       String
  session_token String    @db.VarChar(512)
  ip_address    String?   @db.VarChar(45)
  user_agent    String?   @db.Text
  started_at    DateTime  @default(now())
  last_active   DateTime  @default(now())
  ended_at      DateTime?
  status        String    @default("ACTIVE") @db.VarChar(20)
  policy_id     String?

  user app_user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([session_token])
  @@index([status])
}

model app_user_action {
  id          String   @id @default(uuid())
  user_id     String
  company_id  String?
  module_code String?
  action      String
  path        String
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())
  user        app_user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([company_id])
}

model app_user_token {
  id                 String    @id @default(uuid())
  user_id            String
  token_type         String    @default("JWT") @db.VarChar(20)
  token              String
  refresh_token      String?
  fingerprint        String?   @db.VarChar(128)
  ip_address         String?   @db.VarChar(45)
  user_agent         String?   @db.Text
  device_id          String?   @db.VarChar(100)
  issued_at          DateTime  @default(now())
  access_expires_at  DateTime
  refresh_expires_at DateTime?
  last_activity_at   DateTime?
  is_blocked         Boolean   @default(false)
  blocked_reason     String?   @db.Text
  impersonated_by    String?
  revoked_at         DateTime?
  revoked_reason     String?   @db.Text
  created_at         DateTime  @default(now())

  user app_user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([token])
  @@unique([refresh_token])
  @@index([user_id, revoked_at])
  @@index([token_type])
  @@index([refresh_expires_at])
}

model app_approval_step {
  id        String @id @default(uuid())
  type_id   String
  step      Int
  condition String @default("ANY_APPROVED")

  type      app_signature_type  @relation(fields: [type_id], references: [id], onDelete: Cascade)
  signature app_approval_sign[]

  @@unique([type_id, step])
}

model app_approval_sign {
  id      String @id @default(uuid())
  step_id String
  user_id String

  step app_approval_step @relation(fields: [step_id], references: [id], onDelete: Cascade)
  user app_user          @relation(fields: [user_id], references: [id])

  @@unique([step_id, user_id])
  @@index([user_id])
}

model app_signature_type {
  id         String   @id @default(uuid())
  code       String
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  steps app_approval_step[]
  forms app_signature_form[]

  @@unique([code])
}

model app_signature_form {
  id                String   @id @default(uuid())
  signature_type_id String?
  step              Int
  request_id        String
  condition         String   @default("ANY_APPROVED")
  status            String   @default("PENDING")
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now())

  type            app_signature_type?  @relation(fields: [signature_type_id], references: [id])
  signature_flags app_signature_flag[]

  @@unique([request_id, step])
  @@index([signature_type_id])
}

model app_signature_flag {
  id         String   @id @default(uuid())
  form_id    String
  user_id    String
  status     String   @default("PENDING")
  comment    String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  form app_signature_form @relation(fields: [form_id], references: [id], onDelete: Cascade)
  user app_user           @relation(fields: [user_id], references: [id])

  @@unique([form_id, user_id])
  @@index([user_id])
}

model app_notify_channel {
  id         String   @id @default(uuid())
  company_id String   @default("")
  name       String
  type       String   @default("EMAIL") // EMAIL | WEBHOOK | TELEGRAM | SLACK
  config_enc String?  @db.Text
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  rules    app_notify_rule[]
  messages app_notify_message[]

  @@unique([company_id, name])
  @@index([company_id])
}

model app_notify_template {
  id           String   @id @default(uuid())
  company_id   String   @default("")
  code         String
  channel_type String? // EMAIL | WEBHOOK | TELEGRAM | SLACK
  subject      String?
  body         String   @db.Text
  format       String   @default("TEXT") // TEXT | HTML | MARKDOWN
  locale       String   @default("id")
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())

  rules app_notify_rule[]

  @@unique([company_id, code, locale])
  @@index([company_id])
}

model app_notify_rule {
  id          String   @id @default(uuid())
  company_id  String   @default("")
  event       String
  min_level   String   @default("INFO") // DEBUG | INFO | WARN | ERROR | CRITICAL
  channel_id  String
  template_id String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  channel  app_notify_channel   @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  template app_notify_template? @relation(fields: [template_id], references: [id])
  messages app_notify_message[]

  @@index([company_id, event])
  @@index([channel_id])
}

model app_notify_message {
  id         String    @id @default(uuid())
  company_id String    @default("")
  rule_id    String?
  channel_id String?
  event      String
  target     String?   @db.Text
  subject    String?
  body       String?   @db.Text
  status     String    @default("QUEUED") // QUEUED | SENT | FAILED
  error      String?   @db.Text
  sent_at    DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())

  rule    app_notify_rule?    @relation(fields: [rule_id], references: [id])
  channel app_notify_channel? @relation(fields: [channel_id], references: [id])

  @@index([created_at])
  @@index([company_id])
}

model app_api_key {
  id             String    @id @default(uuid())
  company_id     String    @default("")
  name           String
  key_hash       String    @unique
  scopes         Json?
  last_used_at   DateTime?
  expires_at     DateTime?
  revoked_at     DateTime?
  revoked_reason String?
  is_active      Boolean   @default(true)
  created_by     String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now())

  @@index([company_id])
}

model app_webhook {
  id           String   @id @default(uuid())
  company_id   String   @default("")
  name         String
  url          String   @db.Text
  secret_enc   String?  @db.Text
  events       Json?
  headers      Json?
  is_active    Boolean  @default(true)
  retry_policy Json?
  created_by   String?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())

  deliveries app_webhook_delivery[]

  @@index([company_id])
}

model app_webhook_delivery {
  id          String    @id @default(uuid())
  webhook_id  String
  event       String
  payload     String    @db.Text
  response    String?   @db.Text
  status      Int?
  status_text String?
  attempts    Int       @default(1)
  duration_ms Int?
  succeeded   Boolean   @default(false)
  sent_at     DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now())

  webhook app_webhook @relation(fields: [webhook_id], references: [id], onDelete: Cascade)

  @@index([webhook_id, created_at])
}

model app_integration {
  id             String    @id @default(uuid())
  company_id     String    @default("")
  code           String
  type           String    @default("HRIS") // HRIS | SSO | LDAP | CUSTOM
  config_enc     String?   @db.Text
  map_config     Json?
  is_active      Boolean   @default(true)
  last_synced_at DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now())

  syncs app_integration_sync[]

  @@unique([company_id, code])
  @@index([company_id])
}

model app_integration_sync {
  id             String    @id @default(uuid())
  integration_id String
  direction      String    @default("IMPORT") // IMPORT | EXPORT
  status         String    @default("RUNNING") // RUNNING | SUCCESS | FAILED
  stats          Json?
  error          String?   @db.Text
  started_at     DateTime  @default(now())
  finished_at    DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now())

  integration app_integration @relation(fields: [integration_id], references: [id], onDelete: Cascade)

  @@index([integration_id, started_at])
}

model app_preference {
  id         String   @id @default(uuid())
  company_id String   @default("")
  user_id    String?
  key        String
  value      String?  @db.Text
  scope      String   @default("USER") // USER | COMPANY | GLOBAL
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@index([company_id, user_id, key])
}

model app_report {
  id          String    @id @default(uuid())
  company_id  String    @default("")
  code        String
  name        String
  query       String?   @db.Text
  params      Json?
  format      String    @default("PDF") // PDF | CSV | JSON | XLSX
  schedule    Json?
  is_active   Boolean   @default(true)
  last_run_at DateTime?
  created_by  String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now())

  @@unique([company_id, code])
  @@index([company_id])
}

model app_backup {
  id         String   @id @default(uuid())
  company_id String   @default("")
  code       String
  name       String
  path       String   @db.Text
  size_bytes Int?
  checksum   String?
  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  items app_backup_item[]

  @@index([company_id])
}

model app_backup_item {
  id         String   @id @default(uuid())
  backup_id  String
  entity     String
  count      Int      @default(0)
  checksum   String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  backup app_backup @relation(fields: [backup_id], references: [id], onDelete: Cascade)

  @@index([backup_id])
}

model app_company_setting {
  id         String   @id @default(uuid())
  company_id String
  key        String
  value      String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@unique([company_id, key])
  @@index([company_id])
}

model app_employee {
  id         String   @id @default(uuid())
  company_id String   @default("")
  user_id    String?
  reg_no     String?
  name       String
  department String?
  position   String?
  area_id    String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@index([company_id])
  @@index([user_id])
}
