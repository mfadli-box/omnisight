// Cluster POD — Container/Pod.
// Cluster orkestrasi, node, dan workload.
// Dokumen: osc_docs/database/cluster_pod.md

model pod_cluster {
  id           String   @id @default(uuid())
  company_id   String   @default("")
  code         String
  name         String
  provider     String   @default("K8S") // K8S | OPENSHIFT | NOMAD | DOCKER
  api_endpoint String?
  version      String?
  status       String   @default("UNKNOWN")
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())

  nodes     pod_node[]
  workloads pod_workload[]

  @@unique([company_id, code])
  @@index([company_id])
}

model pod_node {
  id              String    @id @default(uuid())
  cluster_id      String
  name            String
  role            String    @default("WORKER") // WORKER | CONTROL
  ip_address      String?
  cpu_capacity    String?
  mem_capacity_mb Int?
  status          String    @default("UNKNOWN")
  last_seen       DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now())

  cluster pod_cluster @relation(fields: [cluster_id], references: [id], onDelete: Cascade)

  @@unique([cluster_id, name])
  @@index([cluster_id])
}

model pod_workload {
  id             String   @id @default(uuid())
  cluster_id     String
  namespace      String   @default("default")
  name           String
  kind           String   @default("DEPLOYMENT") // DEPLOYMENT | STATEFULSET | DAEMONSET | POD | JOB
  image          String?
  replicas       Int?
  ready_replicas Int?
  status         String   @default("UNKNOWN")
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now())

  cluster pod_cluster @relation(fields: [cluster_id], references: [id], onDelete: Cascade)

  @@unique([cluster_id, namespace, name, kind])
  @@index([cluster_id])
}

model pod_engine {
  id           String   @id @default(uuid())
  company_id   String   @default("")
  code         String
  name         String
  kind         String   @default("DOCKER") // DOCKER | PODMAN
  host         String?
  port         Int?
  api_version  String?
  tls_enabled  Boolean  @default(false)
  ca_cert_enc  String?  @db.Text
  cert_enc     String?  @db.Text
  key_enc      String?  @db.Text
  context_name String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())

  stacks pod_stack[]

  @@unique([company_id, code])
  @@index([company_id])
}

model pod_stack {
  id               String   @id @default(uuid())
  engine_id        String
  code             String
  name             String
  repo_url         String?
  workdir          String?
  file             String?  @default("compose.yaml")
  status           String   @default("IDLE") // IDLE | UP | DOWN | ERROR
  git_sync_enabled Boolean  @default(false)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now())

  engine    pod_engine           @relation(fields: [engine_id], references: [id], onDelete: Cascade)
  revisions pod_stack_revision[]
  services  pod_service[]

  @@unique([engine_id, code])
  @@index([engine_id])
}

model pod_stack_revision {
  id         String   @id @default(uuid())
  stack_id   String
  sha        String
  message    String?  @db.Text
  created_by String?
  created_at DateTime @default(now())

  stack pod_stack @relation(fields: [stack_id], references: [id], onDelete: Cascade)

  @@index([stack_id])
}

model pod_service {
  id         String   @id @default(uuid())
  stack_id   String
  name       String
  image      String?
  scale      Int      @default(1)
  status     String   @default("UNKNOWN") // UNKNOWN | RUNNING | STOPPED
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  stack      pod_stack       @relation(fields: [stack_id], references: [id], onDelete: Cascade)
  containers pod_container[]
  envs       pod_env_var[]

  @@unique([stack_id, name])
  @@index([stack_id])
}

model pod_container {
  id           String    @id @default(uuid())
  service_id   String?
  stack_id     String?
  name         String
  container_id String?
  image        String
  status       String    @default("UNKNOWN")
  ip           String?
  ports        Json?
  started_at   DateTime?
  stopped_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now())

  service pod_service? @relation(fields: [service_id], references: [id], onDelete: Cascade)
  images  pod_image[]

  @@index([service_id])
}

model pod_image {
  id           String   @id @default(uuid())
  container_id String?
  repo         String
  tag          String
  digest       String?
  size_bytes   Int?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())

  container pod_container? @relation(fields: [container_id], references: [id], onDelete: Cascade)

  @@index([container_id])
}

model pod_volume {
  id         String   @id @default(uuid())
  engine_id  String
  name       String
  driver     String   @default("local")
  scope      String   @default("LOCAL") // LOCAL | NAMED
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@index([engine_id])
}

model pod_network {
  id         String   @id @default(uuid())
  engine_id  String
  name       String
  driver     String   @default("bridge")
  internal   Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@index([engine_id])
}

model pod_env_var {
  id         String   @id @default(uuid())
  service_id String?
  key        String
  value_enc  String?  @db.Text
  is_secret  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  service pod_service? @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([service_id])
}

model pod_registry {
  id         String   @id @default(uuid())
  company_id String   @default("")
  name       String
  url        String
  auth       String?  @default("NONE") // NONE | BASIC | TOKEN
  username   String?
  password_enc String? @db.Text
  token_enc  String?  @db.Text
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@index([company_id])
}

model pod_build {
  id         String   @id @default(uuid())
  company_id String   @default("")
  name       String
  repo_url   String?
  dockerfile String?  @default("Dockerfile")
  context    String?  @default(".")
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@index([company_id])
}

model pod_backup {
  id         String   @id @default(uuid())
  company_id String   @default("")
  name       String
  kind       String   @default("STACK") // STACK | VOLUME | SYSTEM
  target_id  String?
  path       String?  @db.Text
  size_bytes Int?
  checksum   String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@index([company_id])
}

model pod_scan {
  id         String   @id @default(uuid())
  company_id String   @default("")
  target     String
  status     String   @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  started_at DateTime?
  finished_at DateTime?
  report     String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  findings   pod_scan_finding[]

  @@index([company_id])
}

model pod_scan_finding {
  id          String   @id @default(uuid())
  scan_id     String
  cve         String?
  severity    String   @default("UNKNOWN") // LOW | MEDIUM | HIGH | CRITICAL | UNKNOWN
  package     String?
  version     String?
  fixed       String?
  description String?  @db.Text
  created_at  DateTime @default(now())

  scan        pod_scan @relation(fields: [scan_id], references: [id], onDelete: Cascade)

  @@index([scan_id])
}

model pod_template {
  id         String   @id @default(uuid())
  company_id String   @default("")
  code       String
  name       String
  content    String   @db.Text
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@unique([company_id, code])
  @@index([company_id])
}

model pod_git_credential {
  id           String   @id @default(uuid())
  company_id   String   @default("")
  name         String
  auth_type    String   @default("HTTPS") // HTTPS | SSH
  username     String?
  password_enc String?  @db.Text
  key_enc      String?  @db.Text
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())

  @@index([company_id])
}

model pod_git_sync {
  id           String   @id @default(uuid())
  stack_id     String?
  company_id   String   @default("")
  repo_url     String
  branch       String   @default("main")
  last_synced  DateTime?
  status       String   @default("IDLE") // IDLE | SYNCING | ERROR
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())

  @@index([company_id])
}
