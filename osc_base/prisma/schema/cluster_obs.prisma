// Cluster OBS — Observability.
// Metrik, log, dan alert. Tabel metrik & log beretensi (telemetry/log).
// Dokumen: osc_docs/database/cluster_obs.md

model obs_metric {
  id          String   @id @default(uuid())
  company_id  String   @default("")
  source      String
  name        String
  value       Float
  unit        String?
  labels      Json?
  recorded_at DateTime @default(now())
  system_id   String?
  metric      String?
  subkey      String?
  created_at  DateTime @default(now())

  @@index([company_id])
  @@index([source, name, recorded_at])
  @@index([recorded_at])
}

model obs_log {
  id          String   @id @default(uuid())
  company_id  String   @default("")
  source      String
  level       String   @default("INFO") // DEBUG | INFO | WARN | ERROR | FATAL
  message     String
  context     Json?
  recorded_at DateTime @default(now())
  created_at  DateTime @default(now())

  @@index([company_id])
  @@index([level])
  @@index([source])
  @@index([recorded_at])
}

model obs_alert {
  id           String    @id @default(uuid())
  company_id   String    @default("")
  code         String
  name         String
  severity     String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  source       String?
  condition    String?
  message      String?
  status       String    @default("FIRING") // FIRING | ACK | RESOLVED
  triggered_at DateTime  @default(now())
  acked_at     DateTime?
  resolved_at  DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now())

  @@unique([company_id, code])
  @@index([company_id])
  @@index([status])
  @@index([severity])
}

model obs_system {
  id         String    @id @default(uuid())
  company_id String    @default("")
  agent_id   String?
  hostname   String
  os         String?
  ip         String?
  last_seen  DateTime?
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())

  @@index([company_id])
}

model obs_check {
  id               String   @id @default(uuid())
  company_id       String   @default("")
  code             String
  name             String
  type             String   @default("HTTP") // HTTP | PING | TCP | DNS | SSL | ICMP | GRPC | MQTT | WS | SMTP | RADIUS | MYSQL | MARIADB | POSTGRES | MONGODB | REDIS
  target           String
  interval         Int      @default(60)
  timeout          Int      @default(10)
  is_active        Boolean  @default(true)
  record_type      String?
  expected         String?
  http_options     Json?
  http_method      String?
  http_headers     Json?
  http_body        String?  @db.Text
  http_auth        Json?
  status_range     String?
  follow_redirects Boolean  @default(true)
  tls_verify       Boolean  @default(true)
  proxy            String?
  push_token       String?
  assertion        String?  @db.Text
  json_path        String?
  keyword          String?
  db_dsn_enc       String?  @db.Text
  tags             Json?
  retry_count      Int      @default(0)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now())

  results obs_check_result[]

  @@unique([company_id, code])
  @@index([company_id])
}

model obs_check_result {
  id          String   @id @default(uuid())
  check_id    String
  status      String   @default("UP") // UP | DOWN | UNKNOWN
  duration_ms Int?
  message     String?  @db.Text
  created_at  DateTime @default(now())

  check obs_check @relation(fields: [check_id], references: [id], onDelete: Cascade)

  @@index([check_id, created_at])
}

model obs_metric_rollup {
  id         String   @id @default(uuid())
  system_id  String?
  metric     String
  bucket     DateTime
  min_value  Float?
  max_value  Float?
  avg_value  Float?
  created_at DateTime @default(now())

  @@index([system_id, metric, bucket])
}

model obs_disk {
  id             String   @id @default(uuid())
  system_id      String
  mount          String?
  device         String?
  fs_type        String?
  total_gb       Float?
  used_gb        Float?
  health         String?
  emmc_life_time Float?
  emmc_pre_eol   Boolean  @default(false)
  mdraid_level   String?
  mdraid_state   String?
  scrub_state    String?
  recorded_at    DateTime @default(now())

  @@index([system_id])
}

model obs_container_stat {
  id           String   @id @default(uuid())
  system_id    String?
  container_id String?
  name         String?
  cpu_pct      Float?
  mem_mb       Float?
  net_rx       BigInt?
  net_tx       BigInt?
  recorded_at  DateTime @default(now())

  @@index([system_id, recorded_at])
}

model obs_vmhost {
  id         String   @id @default(uuid())
  company_id String   @default("")
  name       String
  hypervisor String?
  endpoint   String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@index([company_id])
}

model obs_vm {
  id         String   @id @default(uuid())
  host_id    String?
  company_id String   @default("")
  name       String
  status     String   @default("UNKNOWN")
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@index([company_id])
}

model obs_vm_stat {
  id          String   @id @default(uuid())
  vm_id       String
  cpu_pct     Float?
  mem_mb      Float?
  disk_gb     Float?
  recorded_at DateTime @default(now())

  @@index([vm_id, recorded_at])
}

model obs_service {
  id         String   @id @default(uuid())
  company_id String   @default("")
  name       String
  kind       String   @default("SYSTEMD") // SYSTEMD | DOCKER | TCP
  target     String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@index([company_id])
}

model obs_check_group {
  id         String   @id @default(uuid())
  company_id String   @default("")
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@index([company_id])
}

model obs_alert_rule {
  id           String   @id @default(uuid())
  company_id   String   @default("")
  name         String
  metric       String
  comparator   String   @default("GT")
  threshold    Float
  duration_sec Int      @default(0)
  severity     String   @default("WARNING")
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())

  @@index([company_id])
}

model obs_notification {
  id         String    @id @default(uuid())
  company_id String    @default("")
  channel_id String?
  event      String?
  target     String?
  status     String    @default("QUEUED")
  error      String?   @db.Text
  sent_at    DateTime?
  created_at DateTime  @default(now())

  @@index([company_id, created_at])
}

model obs_notify_channel {
  id         String   @id @default(uuid())
  company_id String   @default("")
  name       String
  type       String   @default("WEBHOOK") // EMAIL | SMTP | WEBHOOK | NTFY | TELEGRAM | SLACK | DISCORD | GOTIFY | PUSHOVER | TEAMS | MATRIX | MATTERMOST | PUSHBULLET | SIGNAL | TWILIO
  config     Json? // terenkripsi
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@unique([company_id, name])
  @@index([company_id])
}

model obs_silence {
  id         String   @id @default(uuid())
  company_id String   @default("")
  rule_id    String?
  starts_at  DateTime
  ends_at    DateTime
  created_by String?
  created_at DateTime @default(now())

  @@index([company_id])
}

model obs_dashboard {
  id         String   @id @default(uuid())
  company_id String   @default("")
  name       String
  layout     Json?
  is_default Boolean  @default(false)
  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@index([company_id])
}

model obs_report {
  id         String   @id @default(uuid())
  company_id String   @default("")
  code       String
  name       String
  params     Json?
  schedule   Json?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@unique([company_id, code])
  @@index([company_id])
}

model obs_maintenance {
  id         String   @id @default(uuid())
  company_id String   @default("")
  title      String
  scope      Json?
  starts_at  DateTime
  ends_at    DateTime
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@index([company_id])
}

model obs_status_page {
  id            String   @id @default(uuid())
  company_id    String   @default("")
  code          String
  name          String
  custom_domain String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())

  @@unique([company_id, code])
  @@index([company_id])
}

model obs_status_page_item {
  id         String   @id @default(uuid())
  page_id    String
  name       String
  check_id   String?
  group      String?
  sort       Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@index([page_id])
}

model obs_status_page_incident {
  id              String    @id @default(uuid())
  page_id         String
  title           String
  body            String?   @db.Text
  status          String    @default("INVESTIGATING") // INVESTIGATING | IDENTIFIED | MONITORING | RESOLVED | SCHEDULED
  impact          String    @default("NONE") // NONE | MINOR | MAJOR | CRITICAL | MAINTENANCE
  is_announcement Boolean   @default(false)
  starts_at       DateTime  @default(now())
  resolves_at     DateTime?
  published_at    DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @default(now())

  @@index([page_id, starts_at])
}

model obs_import_job {
  id         String   @id @default(uuid())
  company_id String   @default("")
  source     String   @default("UPTIME_KUMA")
  status     String   @default("PENDING")
  stats      Json?
  error      String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@index([company_id])
}
