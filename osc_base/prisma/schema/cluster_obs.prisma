// Cluster OBS — Observability.
// Metrik, log, dan alert. Tabel metrik & log beretensi (telemetry/log).
// Dokumen: osc_docs/database/cluster_obs.md

model obs_metric {
  id          String   @id @default(uuid())
  company_id  String   @default("")
  source      String
  name        String
  value       Float
  unit        String?
  labels      Json?
  recorded_at DateTime @default(now())
  created_at  DateTime @default(now())

  @@index([company_id])
  @@index([source, name, recorded_at])
  @@index([recorded_at])
}

model obs_log {
  id          String   @id @default(uuid())
  company_id  String   @default("")
  source      String
  level       String   @default("INFO") // DEBUG | INFO | WARN | ERROR | FATAL
  message     String
  context     Json?
  recorded_at DateTime @default(now())
  created_at  DateTime @default(now())

  @@index([company_id])
  @@index([level])
  @@index([source])
  @@index([recorded_at])
}

model obs_alert {
  id           String    @id @default(uuid())
  company_id   String    @default("")
  code         String
  name         String
  severity     String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  source       String?
  condition    String?
  message      String?
  status       String    @default("FIRING") // FIRING | ACK | RESOLVED
  triggered_at DateTime  @default(now())
  acked_at     DateTime?
  resolved_at  DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now())

  @@unique([company_id, code])
  @@index([company_id])
  @@index([status])
  @@index([severity])
}

model obs_system {
  id         String    @id @default(uuid())
  company_id String    @default("")
  agent_id   String?
  hostname   String
  os         String?
  ip         String?
  last_seen  DateTime?
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())

  @@index([company_id])
}

model obs_check {
  id         String   @id @default(uuid())
  company_id String   @default("")
  code       String
  name       String
  type       String   @default("HTTP") // HTTP | PING | TCP | DNS | SSL | ICMP
  target     String
  interval   Int      @default(60)
  timeout    Int      @default(10)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  results obs_check_result[]

  @@unique([company_id, code])
  @@index([company_id])
}

model obs_check_result {
  id          String   @id @default(uuid())
  check_id    String
  status      String   @default("UP") // UP | DOWN | UNKNOWN
  duration_ms Int?
  message     String?  @db.Text
  created_at  DateTime @default(now())

  check obs_check @relation(fields: [check_id], references: [id], onDelete: Cascade)

  @@index([check_id, created_at])
}
