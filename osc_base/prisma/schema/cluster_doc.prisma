// Cluster DOC — Document & Kolaborasi.
// Repositori dokumen, versi, dan tanda tangan.
// Dokumen: osc_docs/database/cluster_doc.md

model doc_document {
  id          String   @id @default(uuid())
  company_id  String   @default("")
  code        String
  title       String
  category    String?
  description String?
  owner_id    String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  versions doc_version[]
  signs    doc_sign[]

  @@unique([company_id, code])
  @@index([company_id])
}

model doc_version {
  id          String   @id @default(uuid())
  document_id String
  version     Int
  file_path   String?
  mime_type   String?
  size_bytes  BigInt?
  checksum    String?
  change_note String?
  created_at  DateTime @default(now())

  document doc_document @relation(fields: [document_id], references: [id], onDelete: Cascade)
  signs    doc_sign[]

  @@unique([document_id, version])
  @@index([document_id])
}

model doc_sign {
  id          String    @id @default(uuid())
  document_id String
  version_id  String?
  user_id     String
  status      String    @default("PENDING") // PENDING | SIGNED | REJECTED
  comment     String?
  signed_at   DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now())

  document doc_document @relation(fields: [document_id], references: [id], onDelete: Cascade)
  version  doc_version? @relation(fields: [version_id], references: [id])

  @@index([document_id])
  @@index([version_id])
  @@index([user_id])
}

model doc_folder {
  id         String   @id @default(uuid())
  company_id String   @default("")
  parent_id  String?
  name       String
  path       String?
  owner_id   String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  parent   doc_folder?  @relation("FolderTree", fields: [parent_id], references: [id])
  children doc_folder[] @relation("FolderTree")
  files    doc_file[]

  @@unique([company_id, parent_id, name])
  @@index([company_id])
  @@index([parent_id])
}

model doc_file {
  id          String   @id @default(uuid())
  company_id  String   @default("")
  folder_id   String?
  name        String
  mime        String?
  size_bytes  BigInt?
  checksum    String?
  storage     String   @default("LOCAL") // LOCAL | S3
  path        String?  @db.Text
  version     Int      @default(1)
  owner_id    String?
  scan_status String   @default("PENDING") // PENDING | CLEAN | INFECTED | SKIPPED
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  folder   doc_folder?        @relation(fields: [folder_id], references: [id])
  versions doc_file_version[]

  @@index([company_id])
  @@index([folder_id])
  @@index([owner_id])
}

model doc_file_version {
  id         String   @id @default(uuid())
  file_id    String
  version    Int
  size_bytes BigInt?
  checksum   String?
  path       String?  @db.Text
  created_by String?
  created_at DateTime @default(now())

  file doc_file @relation(fields: [file_id], references: [id], onDelete: Cascade)

  @@unique([file_id, version])
  @@index([file_id])
}

model doc_share {
  id                 String    @id @default(uuid())
  company_id         String    @default("")
  file_id            String?
  folder_id          String?
  grantee_user_id    String?
  grantee_company_id String?
  access             String    @default("VIEW") // VIEW | EDIT
  token              String?
  expires_at         DateTime?
  created_at         DateTime  @default(now())

  @@index([company_id])
  @@index([file_id])
  @@index([folder_id])
  @@index([token])
}

model doc_quota {
  id          String   @id @default(uuid())
  company_id  String   @default("")
  scope       String   @default("USER") // USER | COMPANY
  owner_id    String?
  quota_bytes BigInt?
  used_bytes  BigInt   @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  @@unique([company_id, scope, owner_id])
  @@index([company_id])
}
