// Cluster NET — Network Monitoring.
// Perangkat jaringan, topologi (subnet), dan antarmuka.
// Dokumen: osc_docs/database/cluster_net.md

model net_subnet {
  id          String   @id @default(uuid())
  company_id  String   @default("")
  code        String
  name        String
  cidr        String
  gateway     String?
  vlan        Int?
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  devices net_device[]

  @@unique([company_id, code])
  @@index([company_id])
}

model net_device {
  id          String    @id @default(uuid())
  company_id  String    @default("")
  subnet_id   String?
  code        String
  name        String
  hostname    String?
  ip_address  String?
  mac_address String?
  device_type String    @default("SWITCH") // ROUTER | SWITCH | AP | FIREWALL | SERVER | OTHER
  vendor      String?
  model       String?
  location    String?
  status      String    @default("UNKNOWN") // UP | DOWN | UNKNOWN
  last_seen   DateTime?
  notes       String?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now())

  subnet           net_subnet?         @relation(fields: [subnet_id], references: [id])
  interfaces       net_interface[]
  config_backups   net_config_backup[]
  changes          net_change[]
  netSyslogEvents  net_syslog_event[]
  netFirewallRules net_firewall_rule[]

  @@unique([company_id, code])
  @@index([company_id])
  @@index([subnet_id])
  @@index([status])
}

model net_interface {
  id          String   @id @default(uuid())
  device_id   String
  name        String
  if_index    Int?
  mac_address String?
  ip_address  String?
  speed_mbps  Int?
  status      String   @default("UNKNOWN")
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  device net_device @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@unique([device_id, name])
  @@index([device_id])
}

model net_device_group {
  id         String   @id @default(uuid())
  company_id String   @default("")
  code       String
  name       String
  rules      Json?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@unique([company_id, code])
  @@index([company_id])
}

model net_config_backup {
  id           String   @id @default(uuid())
  device_id    String
  kind         String   @default("EXPORT") // EXPORT | BACKUP
  name         String
  content      String?  @db.Text
  content_hash String?
  ros_version  String?
  size_bytes   Int?
  created_by   String?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())

  device net_device @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([device_id, created_at])
}

model net_change {
  id          String   @id @default(uuid())
  company_id  String   @default("")
  device_id   String
  user_id     String?
  action      String   @default("UPDATE") // CREATE | UPDATE | DELETE | ENABLE | DISABLE | MOVE | IMPORT
  target_type String
  target_ref  String?
  before      Json?
  after       Json?
  status      String   @default("PENDING") // PENDING | APPLIED | FAILED | ROLLBACK
  message     String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  device net_device @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([company_id, created_at])
  @@index([device_id, created_at])
}

model net_syslog_event {
  id          String   @id @default(uuid())
  company_id  String   @default("")
  device_id   String?
  source_ip   String?
  facility    String?
  severity    String?
  program     String?
  message     String   @db.Text
  kind        String   @default("SYSLOG") // SYSLOG | TRAP
  dedup_key   String?
  count       Int      @default(1)
  first_seen  DateTime @default(now())
  last_seen   DateTime @default(now())
  recorded_at DateTime @default(now())

  device net_device? @relation(fields: [device_id], references: [id])

  @@index([company_id, recorded_at])
  @@index([company_id, dedup_key])
}

model net_firewall_rule {
  id         String   @id @default(uuid())
  company_id String   @default("")
  device_id  String?
  chain      String
  action     String
  src_addr   String?
  dst_addr   String?
  protocol   String?
  dst_port   String?
  comment    String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  device net_device? @relation(fields: [device_id], references: [id])

  @@index([company_id])
}

model net_alert_rule {
  id         String   @id @default(uuid())
  company_id String   @default("")
  code       String
  name       String
  scope      String   @default("DEVICE") // DEVICE | INTERFACE | SENSOR
  metric     String
  comparator String   @default("GT") // GT | GTE | LT | LTE | EQ
  threshold  Float
  severity   String   @default("WARNING") // INFO | WARNING | CRITICAL
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@unique([company_id, code])
  @@index([company_id])
}
