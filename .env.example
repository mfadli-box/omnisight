# =============================================================================
# omnisight — Environment Template (COMMIT INI, jangan commit `.env`)
# Salin:  cp .env.example .env  lalu isi nilai development masing-masing.
# Aturan: .env berisi kredensial → di-gitignore (*.env di .gitignore:1).
# =============================================================================

# --- General -----------------------------------------------------------------
TZ=Asia/Jakarta

# --- PostgreSQL (service: postgres / osc_base) -------------------------------
# Dev compose : docker-compose.dev.yml  (host 127.0.0.1:<PG_PORT>)
# Master stack: docker-compose.yml      (service osc_base)
PG_DATA=osc                      # nama database
PG_USER=dbe
PG_PASS=password_osc_dbe         # GANTI untuk dev nyata; wajib ganti untuk staging/prod
PG_PORT=5432
DATABASE_URL=postgresql://dbe:password_osc_dbe@localhost:5432/osc?sslmode=disable

# --- RustFS object storage (S3-compatible; service: rustfs / osc_file) -------
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=oscadmin       # GANTI; jangan pakai default di lingkungan bersama
RUSTFS_SECRET_KEY=password_osc_rustfs
RUSTFS_BUCKET=osc                # bucket default lama (dipertahankan agar tidak merusak konfigurasi existing)
RUSTFS_CONSOLE_PORT=9001         # web console dev (bind 127.0.0.1)

# Bucket RustFS per-fungsi (dibuat otomatis oleh one-shot `rustfs_init`;
# lihat docker-compose.yml & osc_docs/devops-bootstrap.md)
RUSTFS_BUCKET_FILES=osc-assets-files      # lampiran file / excel engine
RUSTFS_BUCKET_PAM=osc-pam-recordings      # rekaman sesi PAM (.cast.gz/.mp4 arsip)
RUSTFS_BUCKET_BACKUPS=osc-config-backups  # backup konfigurasi nginx/compose

# --- Keamanan & Kriptografi (WAVE 1/3 — sesuai reengineering.md bab 5.1/5.3/5.7/6) ---
# WAJIB ganti semua nilai di bawah sebelum staging/prod (32 byte acak, hex/base64):
#   openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_jwt_access_secret_32bytes   # signing JWT access (pendek umur)
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret_32bytes # signing JWT refresh (terpisah, revocable)
APP_MASTER_ENCRYPTION_KEY=change_me_master_kek_32bytes  # KEK Envelope AES-256-GCM — HARUS 32 byte
AGENT_ENROLLMENT_SECRET=change_me_agent_enrollment_secret # HMAC secret flow enrollment agent (bab 5.8)
# Allowlist anti-SSRF untuk HRIS ASMX client (host/IP intranet, dipisah koma)
HRIS_ALLOWED_HOSTS=hris.internal.example.local

# --- Bootstrap Seeder Day-2 (reengineering.md bab 5.8; dijalankan otomatis pasca-migrasi) ---
# Seeder idempotent: upsert by username/email, tidak menimpa password yang sudah diubah.
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_EMAIL=superadmin@example.local
BOOTSTRAP_ADMIN_PASSWORD=change_me_on_first_login       # GANTI; wajib ganti saat login pertama

# --- osc_rest (Rust API; port internal, tidak dipublish ke host) -------------
REST_HOST=0.0.0.0
REST_PORT=8000
RUST_LOG=info

# --- osc_site (Next.js; satu-satunya port publik stack) ----------------------
SITE_PORT=3000

