# Contoh environment OmniSight — salin ke `.env` dan isi nilai asli.
# JANGAN commit `.env` (sudah di-gitignore).

TZ=Asia/Jakarta

# ─── Database ────────────────────────────────────────────────
PG_HOST=127.0.0.1
PG_PORT=37771
PG_DATA=osc
PG_BACK=osc_back
PG_USER=dbe
# WAJIB: tanpa ini docker-compose menolak start.
PG_PASS=ubah-menjadi-password-kuat
PG_SSLMODE=disable

# ─── Backend (osc_rest) ──────────────────────────────────────
# WAJIB: kunci enkripsi AES-GCM untuk data sensitif (HRIS dsb).
# Generate: openssl rand -base64 48
RE_SECRET=ubah-menjadi-64-karakter-acak-minimal-32-byte
# Token autentikasi agen (dipisah koma). Kosong = fitur agen nonaktif.
CR_KEYS=
# Alamat bind backend. Pakai 0.0.0.0:37772 HANYA di dalam container.
LISTEN_ADDR=127.0.0.1:37772
# Pool koneksi (true = ukuran besar).
IS_POOL=false
RE_FLAG=true
RE_DAYS=30
RE_LOGS=logs

# Keamanan (opsional, lihat deploy/README.md)
# CORS_ALLOWED_ORIGINS=https://domain.example
# TRUSTED_PROXIES=localhost,172.99.77.1
# WS_ALLOWED_ORIGINS=https://domain.example
# HRIS_ALLOWED_HOSTS=hris.internal.example

# ─── Frontend (osc_site) ─────────────────────────────────────
BE_POOL=http://127.0.0.1:37772
# NEXT_PUBLIC_WS_POOL=wss://domain.example/ws
WS_NAME=OmniSight
WS_META=OmniSight
WS_DESC=ICT Management

# ─── Integrasi lain ──────────────────────────────────────────
AD_MAIL=
AD_PASS=
