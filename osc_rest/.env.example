# osc_rest — template env untuk menjalankan API di HOST (di luar Docker).
# Bila berjalan via docker-compose.yml (root workspace), seluruh variabel
# ini sudah di-inject oleh service `osc_rest` di compose.
#
# CATATAN DEV: RustFS bersifat internal-only (tanpa host port). Untuk
# menjalankan API di host, buka sementara port loopback console/S3 pada
# blok komentar `rustfs` di docker-compose.yml, atau jalankan API di
# dalam jaringan container.

REST_HOST=0.0.0.0
REST_PORT=8000
# Host memakai port ter-publish PostgreSQL (36661), bukan DNS internal.
DATABASE_URL=postgresql://dbe:password_osc_dbe@localhost:36661/osc?sslmode=disable
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=oscadmin
RUSTFS_SECRET_KEY=password_osc_rustfs
RUSTFS_BUCKET=osc
RUST_LOG=info
