# osc_site — template env (server-side saja; TIDAK ada NEXT_PUBLIC_* berisi
# URL internal/secret, sehingga tidak ada yang bocor ke bundle browser).
# Saat berjalan via docker-compose.yml (root), nilai di bawah sudah
# di-inject oleh service `osc_site`.

# Endpoint Rust API untuk server-to-server (BFF) — DNS internal compose.
RUST_API_INTERNAL_URL=http://osc_rest:8000
# Origin publik situs — pembanding Origin/Referer (proteksi CSRF proxy).
SITE_PUBLIC_URL=http://localhost:3000
# Batas ukuran body yang diteruskan proxy (pre-check; batas final di osc_rest).
PROXY_MAX_BODY_MB=25
# Timeout request server-to-server ke Rust API (ms).
RUST_API_TIMEOUT_MS=30000
