# 1. Global & Environment Mode Settings
ENVIRONMENT=production
LOG_LEVEL=info
PUBLIC_APP_URL=http://localhost:36665
APP_ORIGIN=http://localhost:36665

# 2. Database Service: PostgreSQL (osc_base)
POSTGRES_DB=omnisight
POSTGRES_USER=osc
POSTGRES_PASSWORD=YOUR_SECURE_POSTGRES_ROOT_PASSWORD
POSTGRES_APP_PASSWORD=YOUR_SECURE_POSTGRES_APP_PASSWORD
POSTGRES_PORT=36661

# 3. Cache & Session Service: Valkey (osc_temp)
VALKEY_PORT=36662

# 4. Unstructured Log Storage: MongoDB (osc_mongo)
MONGO_INITDB_DATABASE=omnisight
MONGO_ROOT_USER=osc_admin
MONGO_ROOT_PASSWORD=YOUR_SECURE_MONGO_ROOT_PASSWORD
MONGO_PORT=36666

# 5. Object Storage Engine: RustFS (osc_save)
RUSTFS_ACCESS_KEY=omnisight_rustfs_access_key
RUSTFS_SECRET_KEY=YOUR_SECURE_RUSTFS_SECRET_KEY
RUSTFS_BUCKET=omnisight
RUSTFS_REGION=us-east-1
RUSTFS_PORT=36663

# 6. Backend REST API Service: Rust Engine (osc_rest)
REST_PORT=36664
JWT_SECRET=YOUR_JWT_SECRET_BASE64_MIN_32_BYTES
MFA_ENCRYPTION_KEY=YOUR_MFA_ENCRYPTION_KEY_BASE64_EXACT_32_BYTES
HRIS_ALLOWED_HOSTS=hris.web,hris.intranet.local
HRIS_TIMEOUT_SECONDS=3
EMAIL_API_ENDPOINT=http://email.internal/api/v1/send
EMAIL_API_TOKEN=YOUR_EMAIL_SERVICE_BEARER_TOKEN
AGENT_HEARTBEAT_SECRETS={"ubuntu-srv-01":"YOUR_AGENT_SECRET_KEY"}
AGENT_TELEMETRY_SCOPES=metrics,logs,audit,guard
CT02_AUDIT_KEY=
CT02_SERVER_ID=
COMPOSE_PROJECT_NAME=omnisight
STORE_ACCOUNT_ENCRYPTION_KEY=YOUR_STORE_ACCOUNT_ENCRYPTION_KEY_BASE64_EXACT_32_BYTES
SNMP_ENCRYPTION_KEY=YOUR_SNMP_ENCRYPTION_KEY_BASE64_EXACT_32_BYTES

# 7. Frontend Web Application: Next.js (osc_site)
SITE_PORT=36665
INTERNAL_API_URL=http://osc_rest:8080
NEXT_PUBLIC_API_URL=http://localhost:36664

# 8. SRE Agent / Scheduler: Golang Engine (osc_auto)
AGENT_NODE_ID=ubuntu-srv-01
AGENT_SECRET=YOUR_AGENT_SECRET_KEY
OMNISIGHT_TELEMETRY_URL=https://sample.com/
OMNISIGHT_REGISTRATION_URL=https://sample.com/register
